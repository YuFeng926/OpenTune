-        const auto windowScreenBounds = [this]() -> Rectangle<int>
-        {
-            const auto width = getWidth();
-            const auto height = getHeight();
-
-            const auto& displays = Desktop::getInstance().getDisplays();
-
-            if (displays.displays.isEmpty())
-                return { width, height };
