+String AudioDeviceManager::setCurrentAudioDeviceTypeAndSetup (const String& type,
+                                                              const AudioDeviceSetup& setup,
+                                                              bool treatAsChosenDevice,
+                                                              bool openDevice)
+{
+    createDeviceTypesIfNeeded();
+
+    AudioIODeviceType* targetDeviceType = nullptr;
+    for (auto* deviceType : availableDeviceTypes)
+        if (deviceType->getTypeName() == type)
+            targetDeviceType = deviceType;
+
+    if (targetDeviceType == nullptr)
+        return "No such audio device type: " + type;
+
+    const auto typeChanged = currentDeviceType != type;
+    const auto setupChanged = currentSetup != setup || currentAudioDevice != nullptr;
+    const auto oldNumInputChansNeeded = numInputChansNeeded;
+    const auto oldNumOutputChansNeeded = numOutputChansNeeded;
+    if (typeChanged)
+    {
+        if (currentAudioDevice != nullptr)
+        {
+            closeAudioDevice();
+            Thread::sleep (1500); // allow a moment for OS devices to sort themselves out, to help
+                                  // avoid things like DirectSound/ASIO clashes
+        }
+
+        currentDeviceType = type;
+    }
+
+    String error;
+    if (openDevice)
+    {
+        error = setAudioDeviceSetupInternal (setup, false, false);
+    }
+    else
+    {
+        closeAudioDevice();
+        currentSetup = setup;
+        if (! setup.useDefaultInputChannels)
+            numInputChansNeeded = setup.inputChannels.countNumberOfSetBits();
+        if (! setup.useDefaultOutputChannels)
+            numOutputChansNeeded = setup.outputChannels.countNumberOfSetBits();
+    }
+
+    auto setupMatches = currentDeviceType == type
+                     && currentSetup.inputDeviceName == setup.inputDeviceName
+                     && currentSetup.outputDeviceName == setup.outputDeviceName;
+
+    if (! openDevice)
+    {
+        setupMatches = setupMatches && currentAudioDevice == nullptr && currentSetup == setup;
+    }
+    else if (setup.inputDeviceName.isEmpty() && setup.outputDeviceName.isEmpty())
+    {
+        setupMatches = setupMatches && currentAudioDevice == nullptr && currentSetup == setup;
+    }
+    else
+    {
+        auto* const device = currentAudioDevice.get();
+        setupMatches = setupMatches && device != nullptr
+                    && device->getTypeName() == type;
+
+        if (device != nullptr)
+        {
+            if (setup.inputDeviceName.isNotEmpty())
+            {
+                const auto inputDeviceIndex = targetDeviceType->getIndexOfDevice (device, true);
+                const auto inputDeviceNames = targetDeviceType->getDeviceNames (true);
+                setupMatches = setupMatches && inputDeviceIndex >= 0
+                            && inputDeviceIndex < inputDeviceNames.size()
+                            && inputDeviceNames[inputDeviceIndex] == setup.inputDeviceName;
+            }
+
+            if (setup.outputDeviceName.isNotEmpty())
+            {
+                const auto outputDeviceIndex = targetDeviceType->getIndexOfDevice (device, false);
+                const auto outputDeviceNames = targetDeviceType->getDeviceNames (false);
+                setupMatches = setupMatches && outputDeviceIndex >= 0
+                            && outputDeviceIndex < outputDeviceNames.size()
+                            && outputDeviceNames[outputDeviceIndex] == setup.outputDeviceName;
+            }
+
+            const auto hasActiveChannels = ! currentSetup.inputChannels.isZero()
+                                        || ! currentSetup.outputChannels.isZero();
+            if (hasActiveChannels)
+                setupMatches = setupMatches && device->isOpen();
+
+            if (setup.sampleRate > 0.0)
+                setupMatches = setupMatches && device->isOpen()
+                            && std::abs (device->getCurrentSampleRate() - setup.sampleRate) < 0.01;
+
+            if (setup.bufferSize > 0)
+                setupMatches = setupMatches && device->isOpen()
+                            && device->getCurrentBufferSizeSamples() == setup.bufferSize;
+
+            if (! setup.useDefaultInputChannels)
+                setupMatches = setupMatches
+                            && device->getActiveInputChannels() == setup.inputChannels;
+
+            if (! setup.useDefaultOutputChannels)
+                setupMatches = setupMatches
+                            && device->getActiveOutputChannels() == setup.outputChannels;
+        }
+    }
+
+    if (error.isEmpty() && ! setupMatches)
+    {
+        if (openDevice)
+        {
+            numInputChansNeeded = oldNumInputChansNeeded;
+            numOutputChansNeeded = oldNumOutputChansNeeded;
+        }
+
+        error = "The audio device did not apply the requested setup.";
+    }
+
+    if (error.isEmpty() && setupMatches)
+    {
+        for (int i = 0; i < availableDeviceTypes.size(); ++i)
+            if (availableDeviceTypes.getUnchecked (i)->getTypeName() == currentDeviceType)
+                *(lastDeviceTypeConfigs.getUnchecked (i)) = currentSetup;
+
+        if (treatAsChosenDevice)
+            updateXml();
+    }
+
+    if (typeChanged || (! openDevice && setupChanged))
+        sendChangeMessage();
+    return error;
+}
