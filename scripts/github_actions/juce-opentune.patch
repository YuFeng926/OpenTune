+/*
+  ============================================================================
+
+   OpenTune callback admission gate.
+
+   ============================================================================
+*/
+
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <thread>
+
+namespace juce
+{
+
+class OpenTuneCallbackGate final
+{
+    static_assert (std::atomic<bool>::is_always_lock_free);
+    static_assert (std::atomic<std::uint32_t>::is_always_lock_free);
+
+public:
+    class Reader final
+    {
+    public:
+        explicit Reader (OpenTuneCallbackGate& gateIn) noexcept : gate (gateIn)
+        {
+            gate.readers.fetch_add (1, std::memory_order_seq_cst);
+            admitted = gate.isOpen.load (std::memory_order_seq_cst);
+
+            if (! admitted)
+                gate.readers.fetch_sub (1, std::memory_order_seq_cst);
+        }
+
+        ~Reader()
+        {
+            if (admitted)
+                gate.readers.fetch_sub (1, std::memory_order_seq_cst);
+        }
+
+        explicit operator bool() const noexcept { return admitted; }
+
+        Reader (const Reader&) = delete;
+        Reader& operator= (const Reader&) = delete;
+
+    private:
+        OpenTuneCallbackGate& gate;
+        bool admitted = false;
+    };
+
+    class Control final
+    {
+    public:
+        explicit Control (OpenTuneCallbackGate& gateIn) noexcept : gate (gateIn)
+        {
+            gate.closeAndWait();
+        }
+
+        ~Control() { gate.reopen(); }
+
+        Control (const Control&) = delete;
+        Control& operator= (const Control&) = delete;
+
+    private:
+        OpenTuneCallbackGate& gate;
+    };
+
+private:
+    void closeAndWait() noexcept
+    {
+        if (controlDepth++ == 0)
+            isOpen.store (false, std::memory_order_seq_cst);
+
+        while (readers.load (std::memory_order_seq_cst) != 0)
+            std::this_thread::yield();
+    }
+
+    void reopen() noexcept
+    {
+        if (--controlDepth == 0)
+            isOpen.store (true, std::memory_order_seq_cst);
+    }
+
+    std::atomic<bool> isOpen { true };
+    std::atomic<std::uint32_t> readers { 0 };
+    std::uint32_t controlDepth = 0;
+
+    friend class Control;
+};
+
+} // namespace juce
