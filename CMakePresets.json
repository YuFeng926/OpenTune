{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "macos-intel-ara-ninja",
      "displayName": "macOS Intel Ninja Release (ARA2 VST3)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-intel-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.3"
      }
    },
    {
      "name": "macos-silicon-ara-ninja",
      "displayName": "macOS Apple Silicon Ninja Release (ARA2 VST3)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-silicon-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "14.0"
      }
    },
    {
      "name": "macos-ara-ninja",
      "displayName": "macOS Ninja Release (ARA2 VST3) — arm64 alias",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-ara-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "14.0"
      }
    },
    {
      "name": "windows-ara-vs2022",
      "displayName": "Windows VS2022 Release Tree (ARA2 VST3)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-ara-overlay-vs18-clean",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows-ara-ninja",
      "displayName": "Windows Ninja Release (ARA2 VST3)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-ara-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_MAKE_PROGRAM": "F:/VSC/Common7/IDE/CommonExtensions/Microsoft/CMake/Ninja/ninja.exe"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-intel-release",
      "configurePreset": "macos-intel-ara-ninja"
    },
    {
      "name": "macos-silicon-release",
      "configurePreset": "macos-silicon-ara-ninja"
    },
    {
      "name": "macos-ara-release",
      "configurePreset": "macos-ara-ninja"
    },
    {
      "name": "windows-ara-release",
      "configurePreset": "windows-ara-vs2022",
      "configuration": "Release"
    },
    {
      "name": "windows-ara-ninja-release",
      "configurePreset": "windows-ara-ninja"
    }
  ]
}
