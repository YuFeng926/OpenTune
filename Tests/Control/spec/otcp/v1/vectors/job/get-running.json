{
  "$schema": "../../schemas/vector.schema.json",
  "id": "job/get-running",
  "type": "request",
  "description": "job.get without waitMs returns a running job at once. A non-terminal job has no result, no error and no finish time.",
  "capability": "jobs.v1",
  "since": "1.0",
  "method": "job.get",
  "session": "authenticated",
  "given": {
    "jobs": [
      {
        "bind": "exportJob",
        "kind": "export",
        "state": "running",
        "cancellable": true
      }
    ]
  },
  "request": {
    "jsonrpc": "2.0",
    "id": 5,
    "method": "job.get",
    "params": { "jobId": { "$ref": "exportJob" } }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 5,
    "result": {
      "job": {
        "jobId": { "$ref": "exportJob" },
        "kind": "export",
        "state": "running",
        "cancellable": true,
        "createdAtMs": { "$any": "integer" },
        "updatedAtMs": { "$any": "integer" },
        "finishedAtMs": null,
        "progress": { "$any": "object" },
        "result": null,
        "error": null
      }
    }
  },
  "connectionAfter": "open"
}
