{
  "$schema": "../../schemas/vector.schema.json",
  "id": "job/get-not-found",
  "type": "request",
  "description": "A job id that does not exist (or is no longer retained) gives NOT_FOUND(job_not_found).",
  "capability": "jobs.v1",
  "since": "1.0",
  "method": "job.get",
  "session": "authenticated",
  "request": {
    "jsonrpc": "2.0",
    "id": 6,
    "method": "job.get",
    "params": { "jobId": "j:00000000:999999" }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 6,
    "error": {
      "code": -32000,
      "message": "NOT_FOUND",
      "data": {
        "kind": "NOT_FOUND",
        "reason": "job_not_found",
        "retryable": false,
        "detail": { "$any": "string" },
        "executed": false
      }
    }
  },
  "connectionAfter": "open"
}
