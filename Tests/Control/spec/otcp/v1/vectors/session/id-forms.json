    {
      "sendRaw": "{\"jsonrpc\":\"2.0\",\"id\":1.0,\"method\":\"session.info\",\"params\":{}}\n"
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "$any": "object"
        }
      }
    },
    {
      "sendRaw": "{\"jsonrpc\":\"2.0\",\"id\":1e2,\"method\":\"session.info\",\"params\":{}}\n"
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 100,
        "result": {
          "$any": "object"
        }
      }
    },
    {
      "sendRaw": "{\"jsonrpc\":\"2.0\",\"id\":0,\"method\":\"session.info\",\"params\":{}}\n"
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 0,
        "result": {
          "$any": "object"
        }
      }
    },
    {
      "sendRaw": "{\"jsonrpc\":\"2.0\",\"id\":9007199254740991,\"method\":\"session.info\",\"params\":{}}\n"
    },
