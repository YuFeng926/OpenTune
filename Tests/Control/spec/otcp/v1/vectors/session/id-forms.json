{
  "$schema": "../../schemas/vector.schema.json",
  "id": "session/id-forms",
  "type": "scenario",
  "description": "Valid and invalid request ids. A number id is decided by its value, not by how it is written: 1.0, 1e2, 0 and 2^53-1 are valid integer ids, and every response writes them as plain integer literals (1, 100, 0, 9007199254740991), also the fixed AUTH_FAILED response to a hello with id 1e0. A string id of 128 code points is valid even when it has 256 UTF-16 code units and 512 bytes (128 times U+1D11E). A string of 129 characters, the empty string, 1.5, -1 and 2^53 are not valid ids and get INVALID_ARGUMENT(invalid_request) with id null. The session stays open.",
  "capability": "session.v1",
  "since": "1.0",
  "session": "authenticated",
