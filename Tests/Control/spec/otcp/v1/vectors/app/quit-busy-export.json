{
  "$schema": "../../schemas/vector.schema.json",
  "id": "app/quit-busy-export",
  "type": "request",
  "description": "While an export holds the export lock, app.quit does not quit: BUSY(export_in_progress), the reason of PROTOCOL.md section 13.2, not job_in_progress, which names only the jobs that section does not. executed is false and the instance keeps running.",
  "capability": "app.quit",
  "since": "1.0",
  "method": "app.quit",
  "session": "authenticated",
  "given": {
    "jobs": [
      {
        "bind": "exportJob",
        "kind": "export",
        "state": "running",
        "cancellable": true
      }
    ]
  },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "app.quit",
    "params": {}
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "error": {
      "code": -32000,
      "message": "BUSY",
      "data": {
        "kind": "BUSY",
        "reason": "export_in_progress",
        "retryable": true,
        "detail": { "$any": "string" },
        "executed": false
      }
    }
  },
  "connectionAfter": "open"
}
