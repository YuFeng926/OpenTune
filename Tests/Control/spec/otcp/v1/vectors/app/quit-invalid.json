{
  "$schema": "../../schemas/vector.schema.json",
  "id": "app/quit-invalid",
  "type": "request",
  "description": "A discardUnsaved that is not a boolean violates the params schema: INVALID_ARGUMENT(invalid_params), executed false, and the instance keeps running. The consent to lose unsaved changes is never taken from anything but the boolean true.",
  "capability": "app.quit",
  "since": "1.0",
  "method": "app.quit",
  "session": "authenticated",
  "given": {
    "dirty": true
  },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "app.quit",
    "params": { "discardUnsaved": "yes" }
  },
  "paramsValid": false,
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "error": {
      "code": -32602,
      "message": "INVALID_ARGUMENT",
      "data": {
        "kind": "INVALID_ARGUMENT",
        "reason": "invalid_params",
        "retryable": false,
        "detail": { "$any": "string" },
        "executed": false
      }
    }
  },
  "connectionAfter": "open"
}
