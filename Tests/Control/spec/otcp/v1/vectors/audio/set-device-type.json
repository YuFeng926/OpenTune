{
  "$schema": "../../schemas/vector.schema.json",
  "id": "audio/set-device-type",
  "type": "request",
  "description": "audio.set switches to another device type that the machine offers, and OpenTune opens that type's default output device; the sample rate, buffer size and channel pair can differ afterwards, so the vector checks the device type only. The setup is user-global (warning GLOBAL_PREFERENCE); there is no undo entry, and the revert recipe names the previous device type (it also names the other members that the switch changed).",
  "capability": "audio.device",
  "since": "1.0",
  "method": "audio.set",
  "session": "authenticated",
  "given": {
    "dirty": false,
    "audio": {
      "running": true,
      "alternatives": true
    }
  },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "audio.set",
    "params": {
      "deviceType": {
        "$ref": "audio.otherDeviceType"
      }
    }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "result": {
      "applied": true,
      "noOp": false,
      "dryRun": false,
      "changes": [
        {
          "entity": "audioDevice",
          "ref": {
            "singleton": "audioDevice"
          },
          "label": {
            "$any": true
          },
          "fields": {
            "deviceType": {
              "before": {
                "$ref": "audio.deviceType"
              },
              "after": {
                "$ref": "audio.otherDeviceType"
              },
              "unit": null
            }
          }
        }
      ],
      "created": [],
      "removed": [],
      "idMap": [],
      "revisionDiff": {
        "arrangement": null,
        "trackState": null,
        "contents": []
      },
      "tokens": {
        "arrangementRevision": {
          "$any": "string"
        },
        "contents": [],
        "placements": []
      },
      "undo": {
        "undoable": false,
        "reason": "ui_parity",
        "revert": {
          "method": "audio.set",
          "params": {
            "deviceType": {
              "$ref": "audio.deviceType"
            }
          }
        }
      },
      "dirty": {
        "before": false,
        "after": false
      },
      "ui": {
        "$any": true
      },
      "sideEffects": {},
      "warnings": [
        {
          "code": "GLOBAL_PREFERENCE",
          "subject": null,
          "data": {
            "preferences": [
              "audioDevice"
            ]
          }
        }
      ],
      "job": null,
      "device": {
        "running": true,
        "deviceType": {
          "$ref": "audio.otherDeviceType"
        }
      }
    }
  },
  "connectionAfter": "open"
}
