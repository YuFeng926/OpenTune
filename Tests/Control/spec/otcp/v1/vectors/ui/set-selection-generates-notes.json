{
  "$schema": "../../schemas/vector.schema.json",
  "id": "ui/set-selection-generates-notes",
  "type": "request",
  "description": "In the openDyne scheme, selecting a clip whose analysis has finished and whose notes were never generated makes OpenTune generate them, with no undo entry, and mark the project as changed (PROTOCOL.md section 21 rule 3): sideEffects.notesGenerated, the warnings SELECTION_GENERATED_NOTES and IRREVERSIBLE. Precondition: no clip is selected and track 0 is the active track (OpenTune always has an active track), which is the state of a new project; import.start selects the last imported clip and activates its track, so a client that imported the clips resets the selection first.",
  "capability": "ui.bridge",
  "since": "1.0",
  "method": "ui.setSelection",
  "session": "authenticated",
  "given": {
    "dirty": false,
    "editingScheme": "openDyne",
    "clips": [
      {
        "bind": "clip",
        "trackId": 0,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "ready"
      }
    ]
  },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "ui.setSelection",
    "params": { "placementId": { "$ref": "clip.placementId" } }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "result": {
      "applied": true,
      "noOp": false,
      "dryRun": false,
      "changes": [
        {
          "entity": "selection",
          "ref": { "singleton": "selection" },
          "label": { "$any": true },
          "fields": {
            "selectedPlacementIds": {
              "before": [],
              "after": [{ "$ref": "clip.placementId" }],
              "unit": null
            }
          }
        }
      ],
      "created": [],
      "removed": [],
      "idMap": [],
      "revisionDiff": {
        "arrangement": null,
        "trackState": null,
        "contents": [
          {
            "contentId": { "$ref": "clip.contentId" },
            "changed": {
              "notes": {
                "before": { "$any": "string" },
                "after": { "$any": "string" }
              }
            }
          }
        ]
      },
      "tokens": { "$any": "object" },
      "undo": {
        "undoable": false,
        "reason": "not_persisted_state",
        "revert": {
          "method": "ui.setSelection",
          "params": { "trackId": 0 }
        }
      },
      "dirty": { "before": false, "after": true },
      "ui": { "$any": true },
      "sideEffects": {
        "notesGenerated": {
          "contentId": { "$ref": "clip.contentId" },
          "noteCount": { "$any": "integer" },
          "revert": null
        }
      },
      "warnings": [
        {
          "code": "SELECTION_GENERATED_NOTES",
          "subject": { "contentId": { "$ref": "clip.contentId" } },
          "data": null
        },
        {
          "code": "IRREVERSIBLE",
          "subject": { "contentId": { "$ref": "clip.contentId" } },
          "data": null
        }
      ],
      "job": null
    }
  },
  "connectionAfter": "open"
}
