{
  "$schema": "../../schemas/vector.schema.json",
  "id": "ui/get-state-ok",
  "type": "request",
  "description": "ui.getState with no dialog open: no busy condition holds, the dialog list is empty, the onboarding overlay is not showing, and track 0 is the active track (OpenTune always has an active track) with no clip selected.",
  "capability": "ui.bridge",
  "since": "1.0",
  "method": "ui.getState",
  "session": "authenticated",
  "given": { "dirty": false },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "ui.getState",
    "params": {}
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "result": {
      "busy": {
        "pointerDown": false,
        "modalOpen": false,
        "importInProgress": false,
        "exportInProgress": false,
        "projectOperation": false
      },
      "dialogs": [],
      "onboarding": { "shown": { "$any": "boolean" }, "showing": false },
      "ui": {
        "workspace": "arrangement",
        "pianoRollContentId": null,
        "activeTrackId": 0,
        "selectedPlacementIds": [],
        "visibleTrackCount": { "$any": "integer" }
      },
      "uiScale": {
        "root": { "$any": "integer" },
        "scale": { "$any": "string" }
      }
    }
  },
  "connectionAfter": "open"
}
