{
  "$schema": "../../schemas/vector.schema.json",
  "id": "ui/set-selection-dry-run",
  "type": "request",
  "description": "With dryRun true nothing is selected and nothing is generated: the result predicts the selection and the notes that selecting the clip in the openDyne scheme would generate, with the warnings the call would carry. Precondition: no clip is selected and track 0 is the active track (OpenTune always has an active track), which is the state of a new project; import.start selects the last imported clip and activates its track, so a client that imported the clips resets the selection first.",
  "capability": "ui.bridge",
  "since": "1.0",
  "method": "ui.setSelection",
  "session": "authenticated",
  "given": {
    "dirty": false,
    "editingScheme": "openDyne",
    "clips": [
      {
        "bind": "clip",
        "trackId": 0,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "ready"
      }
    ]
  },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "ui.setSelection",
    "params": { "placementId": { "$ref": "clip.placementId" }, "dryRun": true }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "result": {
      "applied": false,
      "noOp": false,
      "dryRun": true,
      "changes": [
        {
          "entity": "selection",
          "ref": { "singleton": "selection" },
          "label": { "$any": true },
          "fields": {
            "selectedPlacementIds": {
              "before": [],
              "after": [{ "$ref": "clip.placementId" }],
              "unit": null
            }
          }
        }
      ],
      "created": [],
      "removed": [],
      "idMap": [],
      "revisionDiff": {
        "arrangement": null,
        "trackState": null,
        "contents": []
      },
      "tokens": { "$any": "object" },
      "undo": null,
      "dirty": { "before": false, "after": false },
      "ui": { "$any": true },
      "sideEffects": {
        "notesGenerated": {
          "contentId": { "$ref": "clip.contentId" },
          "noteCount": { "$any": "integer" },
          "revert": null
        }
      },
      "warnings": [
        {
          "code": "SELECTION_GENERATED_NOTES",
          "subject": { "contentId": { "$ref": "clip.contentId" } },
          "data": null
        },
        {
          "code": "IRREVERSIBLE",
          "subject": { "contentId": { "$ref": "clip.contentId" } },
          "data": null
        }
      ],
      "job": null
    }
  },
  "connectionAfter": "open"
}
