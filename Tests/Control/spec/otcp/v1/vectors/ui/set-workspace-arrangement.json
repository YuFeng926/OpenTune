{
  "$schema": "../../schemas/vector.schema.json",
  "id": "ui/set-workspace-arrangement",
  "type": "scenario",
  "description": "ui.setWorkspace with arrangement closes the piano roll that ui.setSelection with openEditor true opened: the window shows the arrangement view again. The call changes the view only (view state, section 15.2 rule 6): revisionDiff is empty, dirty stays false, sideEffects.workspaceSwitched reports the switch from pianoRoll to arrangement without a revert recipe, ui shows the workspace after the switch, and the revert recipe of the call opens the piano roll again with ui.setWorkspace. The clip stays selected.",
  "capability": "ui.workspace",
  "extraCapabilities": ["ui.bridge"],
  "since": "1.0",
  "session": "authenticated",
  "given": {
    "dirty": false,
    "editingScheme": "openTune",
    "clips": [
      {
        "bind": "clip",
        "trackId": 0,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "ready",
        "notes": [
          { "startContentSec": 0.5, "endContentSec": 1.5, "targetMidi": 64 },
          { "startContentSec": 2, "endContentSec": 3, "targetMidi": 69 }
        ]
      }
    ]
  },
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "ui.setSelection",
        "params": {
          "placementId": { "$ref": "clip.placementId" },
          "openEditor": true
        }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "applied": true,
          "ui": { "workspace": "pianoRoll" },
          "sideEffects": {
            "workspaceSwitched": {
              "from": "arrangement",
              "to": "pianoRoll",
              "revert": null
            }
          }
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "ui.setWorkspace",
        "params": { "workspace": "arrangement" }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": {
          "applied": true,
          "noOp": false,
          "dryRun": false,
          "changes": [
            {
              "entity": "ui",
              "ref": { "singleton": "workspace" },
              "label": { "$any": true },
              "fields": {
                "workspace": {
                  "before": "pianoRoll",
                  "after": "arrangement",
                  "unit": null
                }
              }
            }
          ],
          "created": [],
          "removed": [],
          "idMap": [],
          "revisionDiff": {
            "arrangement": null,
            "trackState": null,
            "contents": []
          },
          "tokens": {
            "arrangementRevision": { "$any": "string" },
            "contents": [],
            "placements": []
          },
          "undo": {
            "undoable": false,
            "reason": "not_persisted_state",
            "revert": {
              "method": "ui.setWorkspace",
              "params": { "workspace": "pianoRoll" }
            }
          },
          "dirty": { "before": false, "after": false },
          "ui": {
            "workspace": "arrangement",
            "selectedPlacementIds": [{ "$ref": "clip.placementId" }]
          },
          "sideEffects": {
            "workspaceSwitched": {
              "from": "pianoRoll",
              "to": "arrangement",
              "revert": null
            }
          },
          "warnings": [],
          "job": null
        }
      }
    }
  ]
}
