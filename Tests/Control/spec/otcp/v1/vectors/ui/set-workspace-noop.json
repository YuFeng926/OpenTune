{
  "$schema": "../../schemas/vector.schema.json",
  "id": "ui/set-workspace-noop",
  "type": "request",
  "description": "Asking for the workspace the window already shows is a no-op: the window shows the arrangement view, so ui.setWorkspace with arrangement succeeds and changes nothing (changes and sideEffects are empty, the undo reason is no_op, revert is null).",
  "capability": "ui.workspace",
  "since": "1.0",
  "method": "ui.setWorkspace",
  "session": "authenticated",
  "given": { "dirty": false },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "ui.setWorkspace",
    "params": { "workspace": "arrangement" }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "result": {
      "applied": true,
      "noOp": true,
      "dryRun": false,
      "changes": [],
      "created": [],
      "removed": [],
      "idMap": [],
      "revisionDiff": {
        "arrangement": null,
        "trackState": null,
        "contents": []
      },
      "tokens": {
        "arrangementRevision": { "$any": "string" },
        "contents": [],
        "placements": []
      },
      "undo": { "undoable": false, "reason": "no_op", "revert": null },
      "dirty": { "before": false, "after": false },
      "ui": { "workspace": "arrangement" },
      "sideEffects": {},
      "warnings": [],
      "job": null
    }
  },
  "connectionAfter": "open"
}
