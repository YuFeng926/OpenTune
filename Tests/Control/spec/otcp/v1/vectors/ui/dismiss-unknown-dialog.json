{
  "$schema": "../../schemas/vector.schema.json",
  "id": "ui/dismiss-unknown-dialog",
  "type": "request",
  "description": "The server cannot tell what closing a dialog of kind unknown does, so ui.getState reports it with closeCommits true and ui.dismiss closes it only with confirm true. Without it the call fails with INVALID_ARGUMENT(dialog_commits_on_close) and closes nothing.",
  "capability": "ui.bridge",
  "since": "1.0",
  "method": "ui.dismiss",
  "session": "authenticated",
  "given": { "dialogs": [{ "kind": "unknown" }] },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "ui.dismiss",
    "params": { "target": "dialogs" }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "error": {
      "code": -32602,
      "message": "INVALID_ARGUMENT",
      "data": {
        "kind": "INVALID_ARGUMENT",
        "reason": "dialog_commits_on_close",
        "retryable": false,
        "detail": { "$any": "string" },
        "executed": false
      }
    }
  },
  "connectionAfter": "open"
}
