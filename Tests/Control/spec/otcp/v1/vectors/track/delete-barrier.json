{
  "$schema": "../../schemas/vector.schema.json",
  "id": "track/delete-barrier",
  "type": "scenario",
  "description": "A clip move made through this API on track 2 is on the undo history. Deleting track 0 moves the clip's track down, so the entry becomes possibly stale: track.delete counts it (possiblyStaleEntries, warning UNDO_HISTORY_POSSIBLY_STALE), edit.getHistory shows possiblyStale true, and edit.undo without force refuses the entry with UNDO_CONFLICT(stale_entry) (PROTOCOL.md section 15.3 rule 6).",
  "capability": "tracks.v1",
  "extraCapabilities": ["history.v1"],
  "since": "1.0",
  "session": "authenticated",
  "given": {
    "visibleTrackCount": 3,
    "clips": [
      {
        "bind": "clip",
        "trackId": 2,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "ready"
      }
    ],
    "history": {
      "undo": [
        {
          "bind": "moveEntry",
          "origin": "control",
          "action": "clipMove",
          "clip": "clip"
        }
      ],
      "redo": []
    }
  },
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "edit.getHistory",
        "params": {}
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "history": {
            "undoTop": {
              "undoId": { "$ref": "moveEntry" },
              "description": { "$any": "string" },
              "origin": "control",
              "unsafe": false,
              "possiblyStale": false
            }
          }
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "track.delete",
        "params": {
          "trackId": 0,
          "expectedArrangementRevision": {
            "$ref": "runner.arrangementRevision"
          },
          "confirm": true
        }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": {
          "applied": true,
          "warnings": [
            {
              "code": "IRREVERSIBLE",
              "subject": { "trackId": 0 },
              "data": null
            },
            {
              "code": "UNDO_HISTORY_POSSIBLY_STALE",
              "subject": null,
              "data": { "undo": 1, "redo": 0 }
            }
          ],
          "possiblyStaleEntries": { "undo": 1, "redo": 0 }
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "edit.getHistory",
        "params": {}
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 3,
        "result": {
          "history": {
            "undoTop": {
              "undoId": { "$ref": "moveEntry" },
              "description": { "$any": "string" },
              "origin": "control",
              "unsafe": false,
              "possiblyStale": true
            }
          }
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "edit.undo",
        "params": { "expectedUndoId": { "$ref": "moveEntry" } }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 4,
        "error": {
          "code": -32000,
          "message": "UNDO_CONFLICT",
          "data": {
            "kind": "UNDO_CONFLICT",
            "reason": "stale_entry",
            "retryable": false,
            "detail": { "$any": "string" },
            "executed": false
          }
        }
      }
    }
  ]
}
