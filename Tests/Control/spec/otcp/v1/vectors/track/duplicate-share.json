{
  "$schema": "../../schemas/vector.schema.json",
  "id": "track/duplicate-share",
  "type": "request",
  "description": "mode share does what OpenTune's UI does: the copied clip shows the same content as its source, so an edit of one shows in the other (warning SHARED_CONTENT). No content is created.",
  "capability": "tracks.v1",
  "since": "1.0",
  "method": "track.duplicate",
  "session": "authenticated",
  "given": {
    "dirty": false,
    "visibleTrackCount": 2,
    "clips": [
      {
        "bind": "clip",
        "trackId": 0,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "ready"
      }
    ]
  },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "track.duplicate",
    "params": { "trackId": 0, "mode": "share" }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "result": {
      "applied": true,
      "noOp": false,
      "dryRun": false,
      "changes": { "$any": "array" },
      "created": [
        {
          "entity": "placement",
          "ref": { "placementId": { "$any": "string" } },
          "label": { "$any": true }
        }
      ],
      "removed": [],
      "idMap": [
        {
          "entity": "placement",
          "relation": "copy",
          "from": [{ "placementId": { "$ref": "clip.placementId" } }],
          "to": [{ "placementId": { "$any": "string" } }]
        }
      ],
      "revisionDiff": {
        "arrangement": {
          "before": { "$ref": "runner.arrangementRevision" },
          "after": { "$any": "string" }
        },
        "trackState": {
          "before": { "$any": "string" },
          "after": { "$any": "string" }
        },
        "contents": []
      },
      "tokens": { "$any": "object" },
      "undo": {
        "undoable": false,
        "reason": "ui_parity",
        "revert": {
          "method": "track.delete",
          "params": {
            "trackId": 2,
            "expectedArrangementRevision": { "$any": "string" }
          },
          "requiresConsent": true
        }
      },
      "dirty": { "before": false, "after": true },
      "ui": { "$any": true },
      "sideEffects": {},
      "warnings": [
        { "code": "SHARED_CONTENT", "subject": { "trackId": 2 }, "data": null }
      ],
      "job": null,
      "newTrackId": 2
    }
  },
  "connectionAfter": "open"
}
