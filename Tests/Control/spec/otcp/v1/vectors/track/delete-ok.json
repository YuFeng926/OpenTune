{
  "$schema": "../../schemas/vector.schema.json",
  "id": "track/delete-ok",
  "type": "request",
  "description": "Deleting track 1 removes its clip and, since no other clip shows it, the clip's content (both listed in removed, PROTOCOL.md section 14.4 rule 6), and moves track 2 with its clip down to position 1 (trackIdMap). The deletion cannot be undone: undo reason no_upstream_undo, revert null, warning IRREVERSIBLE. No undo entry became possibly stale, because the histories are empty.",
  "capability": "tracks.v1",
  "since": "1.0",
  "method": "track.delete",
  "session": "authenticated",
  "given": {
    "dirty": false,
    "visibleTrackCount": 3,
    "clips": [
      {
        "bind": "a",
        "trackId": 0,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "ready"
      },
      {
        "bind": "b",
        "trackId": 1,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "ready"
      },
      {
        "bind": "c",
        "trackId": 2,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "ready"
      }
    ]
  },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "track.delete",
    "params": {
      "trackId": 1,
      "expectedArrangementRevision": { "$ref": "runner.arrangementRevision" },
      "confirm": true
    }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "result": {
      "applied": true,
      "noOp": false,
      "dryRun": false,
      "changes": [
        {
          "entity": "placement",
          "ref": { "placementId": { "$ref": "c.placementId" } },
          "label": { "$any": true },
          "fields": {
            "trackId": { "before": 2, "after": 1, "unit": null }
          }
        }
      ],
      "created": [],
      "removed": [
        {
          "entity": "placement",
          "ref": { "placementId": { "$ref": "b.placementId" } },
          "label": { "$any": true }
        },
        {
          "entity": "content",
          "ref": { "contentId": { "$ref": "b.contentId" } },
          "label": { "$any": true }
        }
      ],
      "idMap": [],
      "revisionDiff": {
        "arrangement": {
          "before": { "$ref": "runner.arrangementRevision" },
          "after": { "$any": "string" }
        },
        "trackState": {
          "before": { "$any": "string" },
          "after": { "$any": "string" }
        },
        "contents": { "$any": "array" }
      },
      "tokens": {
        "arrangementRevision": { "$any": "string" },
        "contents": [],
        "placements": [
          {
            "placementId": { "$ref": "c.placementId" },
            "geometryHash": { "$any": "string" }
          }
        ]
      },
      "undo": {
        "undoable": false,
        "reason": "no_upstream_undo",
        "revert": null
      },
      "dirty": { "before": false, "after": true },
      "ui": { "$any": true },
      "sideEffects": {},
      "warnings": [
        { "code": "IRREVERSIBLE", "subject": { "trackId": 1 }, "data": null }
      ],
      "job": null,
      "trackIdMap": [
        { "before": 1, "after": null },
        { "before": 2, "after": 1 }
      ],
      "possiblyStaleEntries": { "undo": 0, "redo": 0 }
    }
  },
  "connectionAfter": "open"
}
