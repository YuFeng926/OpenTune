{
  "$schema": "../../schemas/vector.schema.json",
  "id": "edit/undo-keeps-later-key",
  "type": "scenario",
  "description": "A note edit, then a key change, which has no undo entry: undoing the note edit puts back the notes only, and the key keeps the value the later change set, since no undo step takes back a change without an undo entry (PROTOCOL.md section 15.3 rule 9).",
  "capability": "history.v1",
  "extraCapabilities": ["edit.v1", "read.v1"],
  "since": "1.0",
  "session": "authenticated",
  "given": {
    "dirty": false,
    "clips": [
      {
        "bind": "clip",
        "trackId": 0,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "ready",
        "key": { "root": 9, "scale": "minor" },
        "notes": [
          { "startContentSec": 0.5, "endContentSec": 1.5, "targetMidi": 64 },
          { "startContentSec": 2, "endContentSec": 3, "targetMidi": 69 }
        ]
      }
    ],
    "history": { "undo": [], "redo": [] }
  },
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "content.editNotes",
        "params": {
          "contentId": { "$ref": "clip.contentId" },
          "expectedRevision": { "$ref": "clip.revision" },
          "ops": [
            { "op": "shiftCents", "select": { "all": true }, "deltaCents": 20 }
          ]
        }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "applied": true,
          "undo": {
            "undoable": true,
            "undoId": { "$capture": "editEntry", "$any": "string" },
            "description": { "$any": "string" },
            "innerActions": { "$any": "array" },
            "steps": 1
          }
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "content.setKey",
        "params": {
          "contentId": { "$ref": "clip.contentId" },
          "key": { "root": 2, "scale": "dorian" }
        }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": {
          "applied": true,
          "noOp": false,
          "undo": {
            "undoable": false,
            "reason": "ui_parity",
            "revert": {
              "method": "content.setKey",
              "params": {
                "contentId": { "$ref": "clip.contentId" },
                "key": { "root": 9, "scale": "minor" },
                "expectedKeyRevision": { "$any": "string" }
              }
            }
          }
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "edit.undo",
        "params": { "expectedUndoId": { "$ref": "editEntry" } }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 3,
        "result": {
          "applied": true,
          "noOp": false,
          "changes": [
            {
              "entity": "content",
              "ref": { "contentId": { "$ref": "clip.contentId" } },
              "label": { "$any": true },
              "fields": {
                "revision": {
                  "before": { "$any": "string" },
                  "after": { "$any": "string" },
                  "unit": null
                }
              }
            }
          ],
          "warnings": [],
          "entry": {
            "undoId": { "$ref": "editEntry" },
            "description": { "$any": "string" },
            "origin": "control",
            "possiblyStale": false,
            "unsafe": false
          }
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "content.getDetails",
        "params": { "contentId": { "$ref": "clip.contentId" } }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 4,
        "result": {
          "key": {
            "root": 2,
            "scale": "dorian",
            "origin": "manual",
            "confidence": null
          }
        }
      }
    }
  ]
}
