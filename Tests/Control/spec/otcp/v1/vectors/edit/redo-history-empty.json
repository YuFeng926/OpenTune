{
  "$schema": "../../schemas/vector.schema.json",
  "id": "edit/redo-history-empty",
  "type": "request",
  "description": "Nothing to redo: the redo history is empty, and the entry the client names is on the undo history. UNDO_CONFLICT(history_empty), and nothing changes.",
  "capability": "history.v1",
  "since": "1.0",
  "method": "edit.redo",
  "session": "authenticated",
  "given": {
    "clips": [
      {
        "bind": "clip",
        "trackId": 0,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "ready"
      }
    ],
    "history": {
      "undo": [
        {
          "bind": "u1",
          "origin": "control",
          "action": "pitchShift",
          "clip": "clip"
        }
      ],
      "redo": []
    }
  },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "edit.redo",
    "params": { "expectedUndoId": { "$ref": "u1" } }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "error": {
      "code": -32000,
      "message": "UNDO_CONFLICT",
      "data": {
        "kind": "UNDO_CONFLICT",
        "reason": "history_empty",
        "retryable": false,
        "detail": { "$any": "string" },
        "executed": false
      }
    }
  },
  "connectionAfter": "open"
}
