{
  "$schema": "../../schemas/vector.schema.json",
  "id": "edit/undo-unsafe-build",
  "type": "request",
  "description": "The top entry is a clip split. After a split OpenTune frees objects its undo entry needs, so undoing it does not restore the clips (PROTOCOL.md section 15.4 rule 1); the server refuses with UNSUPPORTED(undo_unsafe_build), also with force.",
  "capability": "history.v1",
  "since": "1.0",
  "method": "edit.undo",
  "session": "authenticated",
  "given": {
    "clips": [
      {
        "bind": "clip",
        "trackId": 0,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "ready"
      }
    ],
    "history": {
      "undo": [{ "origin": "ui", "action": "clipSplit", "clip": "clip" }],
      "redo": []
    }
  },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "edit.undo",
    "params": { "force": true }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "error": {
      "code": -32000,
      "message": "UNSUPPORTED",
      "data": {
        "kind": "UNSUPPORTED",
        "reason": "undo_unsafe_build",
        "retryable": false,
        "detail": { "$any": "string" },
        "executed": false
      }
    }
  },
  "connectionAfter": "open"
}
