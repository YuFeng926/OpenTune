{
  "$schema": "../../schemas/vector.schema.json",
  "id": "export/start-track",
  "type": "request",
  "description": "Exporting track 0 with ifExists rename.",
  "capability": "export.v1",
  "since": "1.0",
  "method": "export.start",
  "session": "authenticated",
  "given": {
    "dirty": false,
    "clips": [
      {
        "bind": "clip",
        "trackId": 0,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "ready",
        "notes": [
          { "startContentSec": 0.5, "endContentSec": 1.5, "targetMidi": 64 },
          { "startContentSec": 2, "endContentSec": 3, "targetMidi": 69 }
        ]
      }
    ],
    "files": [{ "bind": "out", "kind": "absent" }]
  },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "export.start",
    "params": {
      "kind": "track",
      "target": { "trackId": 0 },
      "path": { "$ref": "out" },
      "ifExists": "rename"
    }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "result": {
      "applied": false,
      "noOp": false,
      "dryRun": false,
      "changes": [],
      "created": [],
      "removed": [],
      "idMap": [],
      "revisionDiff": {
        "arrangement": null,
        "trackState": null,
        "contents": []
      },
      "tokens": { "$any": "object" },
      "undo": null,
      "dirty": { "before": false, "after": false },
      "ui": { "$any": true },
      "sideEffects": {},
      "warnings": [],
      "job": {
        "jobId": { "$any": "string" },
        "kind": "export",
        "state": { "$any": "string" }
      }
    }
  },
  "connectionAfter": "open"
}
