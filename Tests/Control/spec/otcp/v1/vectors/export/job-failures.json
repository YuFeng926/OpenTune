            "updatedAtMs": { "$any": "integer" },
            "finishedAtMs": { "$any": "integer" },
            "progress": { "$any": "object" },
            "result": { "$any": true },
            "error": {
              "code": -32000,
              "message": "CANCELLED",
              "data": {
                "kind": "CANCELLED",
                "reason": "cancelled_by_request",
                "retryable": false,
                "detail": { "$any": "string" },
                "executed": false
              }
            }
          }
        }
      }
    }
  ]
}
