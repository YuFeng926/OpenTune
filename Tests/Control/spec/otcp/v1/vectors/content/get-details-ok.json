{
  "$schema": "../../schemas/vector.schema.json",
  "id": "content/get-details-ok",
  "type": "request",
  "description": "content.getDetails of a clip with a key, a pitch shift of -2 semitones and a seeded time grid with two handles. Placement-dependent values are taken through the clip's only placement. In the openTune scheme the AUTO button runs regenerate. The minimum handle spacing is implementation-defined, so it is matched by type as well.",
  "capability": "read.v1",
  "since": "1.0",
  "method": "content.getDetails",
  "session": "authenticated",
  "given": {
    "editingScheme": "openTune",
    "clips": [
      {
        "bind": "clip",
        "trackId": 0,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "ready",
        "key": { "root": 9, "scale": "minor" },
        "pitchShift": { "semitones": -2, "cents": 0 },
        "timeGrid": [
          { "bind": "h1", "contentSec": 1 },
          { "bind": "h2", "contentSec": 2.5 }
        ]
      }
    ]
  },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "content.getDetails",
    "params": { "contentId": { "$ref": "clip.contentId" } }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "result": {
      "asOf": {
        "arrangementRevision": { "$any": "string" },
        "contents": [
          {
            "contentId": { "$ref": "clip.contentId" },
            "revision": { "$ref": "clip.revision" },
            "gridRevision": { "$ref": "clip.gridRevision" },
            "keyRevision": { "$ref": "clip.keyRevision" }
          }
        ]
      },
      "derived": { "$any": "array" },
      "contentId": { "$ref": "clip.contentId" },
      "viaPlacementId": { "$ref": "clip.placementId" },
      "placementIds": [{ "$ref": "clip.placementId" }],
      "durationSec": { "$approx": 6 },
      "key": {
        "root": 9,
        "scale": "minor",
        "origin": { "$any": "string" },
        "confidence": { "$any": true }
      },
      "pitchShift": { "semitones": -2, "cents": 0 },
      "analysis": {
        "f0State": "ready",
        "failure": null,
        "hopSec": { "$any": "number" }
      },
      "render": {
        "current": { "$any": "boolean" },
        "publishedRevision": { "$any": "string" },
        "desiredRevision": { "$any": "string" }
      },
      "timeGrid": {
        "seeded": true,
        "identity": true,
        "handles": [
          {
            "handleId": { "$ref": "h1" },
            "contentSec": { "$approx": 1 },
            "outputSec": { "$approx": 1 }
          },
          {
            "handleId": { "$ref": "h2" },
            "contentSec": { "$approx": 2.5 },
            "outputSec": { "$approx": 2.5 }
          }
        ],
        "minHandleSpacingSec": { "$any": "number" }
      },
      "autoModes": {
        "editingScheme": "openTune",
        "uiButtonRuns": "regenerate",
        "available": { "$any": "array" }
      }
    }
  },
  "connectionAfter": "open"
}
