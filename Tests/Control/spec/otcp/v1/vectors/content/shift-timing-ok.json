{
  "$schema": "../../schemas/vector.schema.json",
  "id": "content/shift-timing-ok",
  "type": "request",
  "description": "Shifting the section 1.5-2.5 s (output clock) 30 ms later moves the one handle in it, h2, from 2.0 to 2.03 s; the neighbouring handles stay, so the audio around the section is stretched or compressed. Only the grid aspect changes; revision stays.",
  "capability": "timing.v1",
  "since": "1.0",
  "method": "content.shiftTiming",
  "session": "authenticated",
  "given": {
    "dirty": false,
    "clips": [
      {
        "bind": "clip",
        "trackId": 0,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "ready",
        "notes": [
          { "startContentSec": 0.5, "endContentSec": 1.5, "targetMidi": 64 },
          { "startContentSec": 2, "endContentSec": 3, "targetMidi": 69 }
        ],
        "timeGrid": [
          { "bind": "h1", "contentSec": 1 },
          { "bind": "h2", "contentSec": 2 },
          { "bind": "h3", "contentSec": 3 }
        ]
      }
    ]
  },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "content.shiftTiming",
    "params": {
      "contentId": { "$ref": "clip.contentId" },
      "expectedGridRevision": { "$ref": "clip.gridRevision" },
      "range": { "startOutputSec": 1.5, "endOutputSec": 2.5 },
      "deltaSec": 0.03
    }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "result": {
      "applied": true,
      "noOp": false,
      "dryRun": false,
      "changes": [
        {
          "entity": "timeHandle",
          "ref": {
            "contentId": { "$ref": "clip.contentId" },
            "handleId": { "$ref": "h2" }
          },
          "label": { "$any": true },
          "fields": {
            "outputSec": {
              "before": { "$approx": 2 },
              "after": { "$approx": 2.03 },
              "unit": "sec"
            }
          }
        }
      ],
      "created": [],
      "removed": [],
      "idMap": [],
      "revisionDiff": {
        "arrangement": null,
        "trackState": null,
        "contents": [
          {
            "contentId": { "$ref": "clip.contentId" },
            "changed": {
              "grid": {
                "before": { "$ref": "clip.gridRevision" },
                "after": { "$any": "string" }
              }
            }
          }
        ]
      },
      "tokens": {
        "arrangementRevision": { "$any": "string" },
        "contents": [
          {
            "contentId": { "$ref": "clip.contentId" },
            "revision": { "$ref": "clip.revision" },
            "gridRevision": { "$any": "string" },
            "keyRevision": { "$ref": "clip.keyRevision" }
          }
        ],
        "placements": []
      },
      "undo": {
        "undoable": true,
        "undoId": { "$any": "string" },
        "description": { "$any": "string" },
        "innerActions": { "$any": "array" },
        "steps": 1
      },
      "dirty": { "before": false, "after": true },
      "ui": { "$any": true },
      "sideEffects": {
        "reRenderQueued": {
          "contentIds": [{ "$ref": "clip.contentId" }],
          "revert": null
        }
      },
      "warnings": [],
      "job": null,
      "clamped": []
    }
  },
  "connectionAfter": "open"
}
