{
  "$schema": "../../schemas/vector.schema.json",
  "id": "content/auto-tune-regenerate",
  "type": "request",
  "description": "AUTO regenerate over 1.0-4.0 s of a content with four notes. Note 1 lies inside the range and is replaced; notes 0 and 2 touch the edges of the range and are dropped, not regenerated (warning DROPPED_BOUNDARY_NOTES, an OpenTune behaviour); note 3 is outside and stays. The three removed notes are referenced at the revision before the call. How many notes are created depends on the audio. One undo step.",
  "capability": "edit.v1",
  "since": "1.0",
  "method": "content.autoTune",
  "session": "authenticated",
  "given": {
    "dirty": false,
    "clips": [
      {
        "bind": "clip",
        "trackId": 0,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "ready",
        "notes": [
          { "startContentSec": 0.5, "endContentSec": 1.5, "targetMidi": 64 },
          { "startContentSec": 2, "endContentSec": 3, "targetMidi": 69 },
          { "startContentSec": 3.5, "endContentSec": 4.5, "targetMidi": 69.3 },
          { "startContentSec": 5, "endContentSec": 5.8, "targetMidi": 66.2 }
        ]
      }
    ]
  },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "content.autoTune",
    "params": {
      "contentId": { "$ref": "clip.contentId" },
      "mode": "regenerate",
      "expectedRevision": { "$ref": "clip.revision" },
      "ranges": [{ "startContentSec": 1, "endContentSec": 4 }],
      "key": { "root": 0, "scale": "major" }
    }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "result": {
      "applied": true,
      "noOp": false,
      "dryRun": false,
      "changes": [],
      "created": { "$any": "array" },
      "removed": [
        {
          "entity": "note",
          "ref": {
            "contentId": { "$ref": "clip.contentId" },
            "note": { "index": 0, "atRevision": { "$ref": "clip.revision" } }
          },
          "label": { "$any": true }
        },
        {
          "entity": "note",
          "ref": {
            "contentId": { "$ref": "clip.contentId" },
            "note": { "index": 1, "atRevision": { "$ref": "clip.revision" } }
          },
          "label": { "$any": true }
        },
        {
          "entity": "note",
          "ref": {
            "contentId": { "$ref": "clip.contentId" },
            "note": { "index": 2, "atRevision": { "$ref": "clip.revision" } }
          },
          "label": { "$any": true }
        }
      ],
      "idMap": [],
      "revisionDiff": {
        "arrangement": null,
        "trackState": null,
        "contents": [
          {
            "contentId": { "$ref": "clip.contentId" },
            "changed": {
              "notes": {
                "before": { "$any": "string" },
                "after": { "$any": "string" }
              }
            }
          }
        ]
      },
      "tokens": {
        "arrangementRevision": { "$any": "string" },
        "contents": [
          {
            "contentId": { "$ref": "clip.contentId" },
            "revision": { "$any": "string" },
            "gridRevision": { "$ref": "clip.gridRevision" },
            "keyRevision": { "$ref": "clip.keyRevision" }
          }
        ],
        "placements": []
      },
      "undo": {
        "undoable": true,
        "undoId": { "$any": "string" },
        "description": { "$any": "string" },
        "innerActions": { "$any": "array" },
        "steps": 1
      },
      "dirty": { "before": false, "after": true },
      "ui": { "$any": true },
      "sideEffects": {
        "reRenderQueued": {
          "contentIds": [{ "$ref": "clip.contentId" }],
          "revert": null
        }
      },
      "warnings": [
        {
          "code": "DROPPED_BOUNDARY_NOTES",
          "subject": { "contentId": { "$ref": "clip.contentId" } },
          "data": {
            "notes": [
              {
                "note": {
                  "index": 0,
                  "atRevision": { "$ref": "clip.revision" }
                },
                "startContentSec": { "$approx": 0.5 },
                "endContentSec": { "$approx": 1.5 }
              },
              {
                "note": {
                  "index": 2,
                  "atRevision": { "$ref": "clip.revision" }
                },
                "startContentSec": { "$approx": 3.5 },
                "endContentSec": { "$approx": 4.5 }
              }
            ]
          }
        }
      ],
      "job": null,
      "omittedCount": { "changes": 0, "created": 0, "removed": 0 },
      "mode": "regenerate",
      "keyUsed": { "root": 0, "scale": "major" },
      "paramsUsed": { "$any": "object" },
      "noteCount": { "before": 4, "after": { "$any": "integer" } }
    }
  },
  "connectionAfter": "open"
}
