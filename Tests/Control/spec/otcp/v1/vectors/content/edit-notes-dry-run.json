{
  "$schema": "../../schemas/vector.schema.json",
  "id": "content/edit-notes-dry-run",
  "type": "request",
  "description": "With dryRun the result predicts the changes and applies nothing: applied is false, the revision vector difference is empty, the tokens are the current ones, there is no undo descriptor and the project is not marked as changed.",
  "capability": "edit.v1",
  "since": "1.0",
  "method": "content.editNotes",
  "session": "authenticated",
  "given": {
    "dirty": false,
    "clips": [
      {
        "bind": "clip",
        "trackId": 0,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "ready",
        "notes": [
          { "startContentSec": 0.5, "endContentSec": 1.5, "targetMidi": 64 },
          { "startContentSec": 2, "endContentSec": 3, "targetMidi": 69 },
          { "startContentSec": 3.5, "endContentSec": 4.5, "targetMidi": 69.3 }
        ]
      }
    ]
  },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "content.editNotes",
    "params": {
      "contentId": { "$ref": "clip.contentId" },
      "expectedRevision": { "$ref": "clip.revision" },
      "dryRun": true,
      "ops": [
        {
          "op": "setTargetPitch",
          "select": { "indices": [0] },
          "targetMidi": 65
        }
      ]
    }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "result": {
      "applied": false,
      "noOp": false,
      "dryRun": true,
      "changes": [
        {
          "entity": "note",
          "ref": {
            "contentId": { "$ref": "clip.contentId" },
            "note": { "index": 0, "atRevision": { "$any": "string" } }
          },
          "label": { "$any": true },
          "fields": {
            "targetMidi": {
              "before": { "$approx": 64 },
              "after": { "$approx": 65 },
              "unit": "midi"
            }
          }
        }
      ],
      "created": [],
      "removed": [],
      "idMap": [],
      "revisionDiff": {
        "arrangement": null,
        "trackState": null,
        "contents": []
      },
      "tokens": {
        "arrangementRevision": { "$any": "string" },
        "contents": [
          {
            "contentId": { "$ref": "clip.contentId" },
            "revision": { "$ref": "clip.revision" },
            "gridRevision": { "$ref": "clip.gridRevision" },
            "keyRevision": { "$ref": "clip.keyRevision" }
          }
        ],
        "placements": []
      },
      "undo": null,
      "dirty": { "before": false, "after": false },
      "ui": { "$any": true },
      "sideEffects": {},
      "warnings": [],
      "job": null,
      "omittedChangeCount": 0
    }
  },
  "connectionAfter": "open"
}
