{
  "$schema": "../../schemas/vector.schema.json",
  "id": "content/get-notes-timeline",
  "type": "request",
  "description": "content.getNotes by placementId with a timeline range. The clip starts at 2 s, so the range 4.0-4.6 s on the timeline is 2.0-2.6 s of the content and keeps only note 1; the note also carries its timeline times. Indexes stay those of all notes.",
  "capability": "read.v1",
  "since": "1.0",
  "method": "content.getNotes",
  "session": "authenticated",
  "given": {
    "clips": [
      {
        "bind": "clip",
        "trackId": 0,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "ready",
        "notes": [
          { "startContentSec": 0.5, "endContentSec": 1.5, "targetMidi": 64 },
          { "startContentSec": 2, "endContentSec": 3, "targetMidi": 69 },
          { "startContentSec": 3.5, "endContentSec": 4.5, "targetMidi": 69.3 }
        ]
      }
    ]
  },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "content.getNotes",
    "params": {
      "placementId": { "$ref": "clip.placementId" },
      "range": { "startTimelineSec": 4, "endTimelineSec": 4.6 }
    }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "result": {
      "asOf": {
        "arrangementRevision": { "$any": "string" },
        "contents": [
          {
            "contentId": { "$ref": "clip.contentId" },
            "revision": { "$ref": "clip.revision" },
            "gridRevision": { "$ref": "clip.gridRevision" },
            "keyRevision": { "$ref": "clip.keyRevision" }
          }
        ]
      },
      "derived": { "$any": "array" },
      "contentId": { "$ref": "clip.contentId" },
      "placementId": { "$ref": "clip.placementId" },
      "tuningHz": { "$any": "number" },
      "totalCount": 1,
      "notes": [
        {
          "index": 1,
          "label": { "$any": "string" },
          "startContentSec": { "$approx": 2 },
          "endContentSec": { "$approx": 3 },
          "startTimelineSec": { "$approx": 4 },
          "endTimelineSec": { "$approx": 5 },
          "detectedMidi": { "$any": true },
          "targetMidi": { "$approx": 69 },
          "offsetCents": { "$approx": 0 },
          "retuneSpeed": { "$any": "number" },
          "vibratoDepth": { "$any": "number" },
          "vibratoRateHz": { "$any": "number" },
          "pitchDriftScale": { "$any": "number" },
          "voiced": { "$any": "boolean" },
          "corrected": { "$any": "boolean" }
        }
      ],
      "nextCursor": null
    }
  },
  "connectionAfter": "open"
}
