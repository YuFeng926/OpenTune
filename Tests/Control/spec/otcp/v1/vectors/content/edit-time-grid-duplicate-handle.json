{
  "$schema": "../../schemas/vector.schema.json",
  "id": "content/edit-time-grid-duplicate-handle",
  "type": "request",
  "description": "moveHandles names h1 twice. Each handle may appear in moves only once: INVALID_ARGUMENT(duplicate_handle), and no handle moves.",
  "capability": "timing.v1",
  "since": "1.0",
  "method": "content.editTimeGrid",
  "session": "authenticated",
  "given": {
    "dirty": false,
    "clips": [
      {
        "bind": "clip",
        "trackId": 0,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "ready",
        "notes": [
          { "startContentSec": 0.5, "endContentSec": 1.5, "targetMidi": 64 },
          { "startContentSec": 2, "endContentSec": 3, "targetMidi": 69 }
        ],
        "timeGrid": [
          { "bind": "h1", "contentSec": 1 },
          { "bind": "h2", "contentSec": 2 },
          { "bind": "h3", "contentSec": 3 }
        ]
      }
    ]
  },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "content.editTimeGrid",
    "params": {
      "contentId": { "$ref": "clip.contentId" },
      "op": "moveHandles",
      "expectedGridRevision": { "$ref": "clip.gridRevision" },
      "moves": [
        { "handleId": { "$ref": "h1" }, "outputSec": 1.1 },
        { "handleId": { "$ref": "h1" }, "outputSec": 1.2 }
      ]
    }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "error": {
      "code": -32602,
      "message": "INVALID_ARGUMENT",
      "data": {
        "kind": "INVALID_ARGUMENT",
        "reason": "duplicate_handle",
        "retryable": false,
        "detail": { "$any": "string" },
        "executed": false
      }
    }
  },
  "connectionAfter": "open"
}
