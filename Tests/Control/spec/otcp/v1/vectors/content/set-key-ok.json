{
  "$schema": "../../schemas/vector.schema.json",
  "id": "content/set-key-ok",
  "type": "request",
  "description": "Setting A minor to C major. As in the OpenTune UI the change has no undo entry; the revert recipe sets A minor again and carries the key revision after the change. The revert is partial: the restored key is a manual key, without the origin and confidence of a detected key. Only the key aspect changes: revision and gridRevision stay as they were (PROTOCOL.md section 10 rule 2).",
  "capability": "edit.v1",
  "since": "1.0",
  "method": "content.setKey",
  "session": "authenticated",
  "given": {
    "dirty": false,
    "clips": [
      {
        "bind": "clip",
        "trackId": 0,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "ready",
        "key": { "root": 9, "scale": "minor" },
        "notes": [
          { "startContentSec": 0.5, "endContentSec": 1.5, "targetMidi": 64 },
          { "startContentSec": 2, "endContentSec": 3, "targetMidi": 69 }
        ]
      }
    ]
  },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "content.setKey",
    "params": {
      "contentId": { "$ref": "clip.contentId" },
      "key": { "root": 0, "scale": "major" }
    }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "result": {
      "applied": true,
      "noOp": false,
      "dryRun": false,
      "changes": [
        {
          "entity": "key",
          "ref": { "contentId": { "$ref": "clip.contentId" } },
          "label": { "$any": true },
          "fields": {
            "root": { "before": 9, "after": 0, "unit": null },
            "scale": { "before": "minor", "after": "major", "unit": null }
          }
        }
      ],
      "created": [],
      "removed": [],
      "idMap": [],
      "revisionDiff": {
        "arrangement": null,
        "trackState": null,
        "contents": [
          {
            "contentId": { "$ref": "clip.contentId" },
            "changed": {
              "key": {
                "before": { "$ref": "clip.keyRevision" },
                "after": { "$any": "string" }
              }
            }
          }
        ]
      },
      "tokens": {
        "arrangementRevision": { "$any": "string" },
        "contents": [
          {
            "contentId": { "$ref": "clip.contentId" },
            "revision": { "$ref": "clip.revision" },
            "gridRevision": { "$ref": "clip.gridRevision" },
            "keyRevision": { "$any": "string" }
          }
        ],
        "placements": []
      },
      "undo": {
        "undoable": false,
        "reason": "ui_parity",
        "revert": {
          "method": "content.setKey",
          "params": {
            "contentId": { "$ref": "clip.contentId" },
            "key": { "root": 9, "scale": "minor" },
            "expectedKeyRevision": { "$any": "string" }
          }
        }
      },
      "dirty": { "before": false, "after": true },
      "ui": { "$any": true },
      "sideEffects": {},
      "warnings": [],
      "job": null
    }
  },
  "connectionAfter": "open"
}
