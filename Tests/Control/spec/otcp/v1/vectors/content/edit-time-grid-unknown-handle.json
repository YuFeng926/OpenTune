{
  "$schema": "../../schemas/vector.schema.json",
  "id": "content/edit-time-grid-unknown-handle",
  "type": "request",
  "description": "A handleId that is not in the content's time grid gives NOT_FOUND(unknown_handle).",
  "capability": "timing.v1",
  "since": "1.0",
  "method": "content.editTimeGrid",
  "session": "authenticated",
  "given": {
    "dirty": false,
    "clips": [
      {
        "bind": "clip",
        "trackId": 0,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "ready",
        "notes": [
          { "startContentSec": 0.5, "endContentSec": 1.5, "targetMidi": 64 },
          { "startContentSec": 2, "endContentSec": 3, "targetMidi": 69 }
        ],
        "timeGrid": [
          { "bind": "h1", "contentSec": 1 },
          { "bind": "h2", "contentSec": 2 },
          { "bind": "h3", "contentSec": 3 }
        ]
      }
    ]
  },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "content.editTimeGrid",
    "params": {
      "contentId": { "$ref": "clip.contentId" },
      "op": "moveHandles",
      "expectedGridRevision": { "$ref": "clip.gridRevision" },
      "moves": [{ "handleId": "no-such-handle", "outputSec": 1 }]
    }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "error": {
      "code": -32000,
      "message": "NOT_FOUND",
      "data": {
        "kind": "NOT_FOUND",
        "reason": "unknown_handle",
        "retryable": false,
        "detail": { "$any": "string" },
        "executed": false
      }
    }
  },
  "connectionAfter": "open"
}
