          {
            "startContentSec": 2,
            "endContentSec": 3,
            "targetMidi": 69
          },
          {
            "startContentSec": 3.5,
            "endContentSec": 4.5,
            "targetMidi": 69.3
          },
          {
            "startContentSec": 5,
            "endContentSec": 5.8,
            "targetMidi": 66.2
