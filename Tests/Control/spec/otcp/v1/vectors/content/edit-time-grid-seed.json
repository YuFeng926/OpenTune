{
  "$schema": "../../schemas/vector.schema.json",
  "id": "content/edit-time-grid-seed",
  "type": "scenario",
  "description": "op seed hands the work to a job of kind timeGridSeed. Its result is the write envelope: the handles were created, only the grid aspect changed, and, as in OpenTune, seeding has no undo entry and no revert recipe (warning IRREVERSIBLE), although it does not change how the content sounds.",
  "capability": "timing.v1",
  "extraCapabilities": ["jobs.v1"],
  "since": "1.0",
  "session": "authenticated",
  "given": {
    "dirty": false,
    "clips": [
      {
        "bind": "clip",
        "trackId": 0,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "ready",
        "notes": [
          { "startContentSec": 0.5, "endContentSec": 1.5, "targetMidi": 64 },
          { "startContentSec": 2, "endContentSec": 3, "targetMidi": 69 }
        ]
      }
    ]
  },
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "content.editTimeGrid",
        "params": { "contentId": { "$ref": "clip.contentId" }, "op": "seed" }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "applied": false,
          "noOp": false,
          "dryRun": false,
          "changes": [],
          "created": [],
          "removed": [],
          "idMap": [],
          "revisionDiff": {
            "arrangement": null,
            "trackState": null,
            "contents": []
          },
          "tokens": { "$any": "object" },
          "undo": null,
          "dirty": { "before": false, "after": false },
          "ui": { "$any": true },
          "sideEffects": {},
          "warnings": [],
          "job": {
            "jobId": { "$capture": "seedJob", "$any": "string" },
            "kind": "timeGridSeed",
            "state": { "$any": "string" }
          },
          "clamped": []
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "job.get",
        "params": { "jobId": { "$ref": "seedJob" }, "waitMs": 30000 }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": {
          "job": {
            "jobId": { "$ref": "seedJob" },
            "kind": "timeGridSeed",
            "state": "succeeded",
            "cancellable": false,
            "createdAtMs": { "$any": "integer" },
            "updatedAtMs": { "$any": "integer" },
            "finishedAtMs": { "$any": "integer" },
            "progress": { "$any": "object" },
            "result": {
              "applied": true,
              "noOp": false,
              "dryRun": false,
              "changes": [],
              "created": { "$any": "array" },
              "removed": [],
              "idMap": [],
              "revisionDiff": {
                "arrangement": null,
                "trackState": null,
                "contents": [
                  {
                    "contentId": { "$ref": "clip.contentId" },
                    "changed": {
                      "grid": {
                        "before": { "$ref": "clip.gridRevision" },
                        "after": { "$any": "string" }
                      }
                    }
                  }
                ]
              },
              "tokens": {
                "arrangementRevision": { "$any": "string" },
                "contents": [
                  {
                    "contentId": { "$ref": "clip.contentId" },
                    "revision": { "$ref": "clip.revision" },
                    "gridRevision": { "$any": "string" },
                    "keyRevision": { "$ref": "clip.keyRevision" }
                  }
                ],
                "placements": []
              },
              "undo": {
                "undoable": false,
                "reason": "ui_parity",
                "revert": null
              },
              "dirty": { "before": false, "after": true },
              "ui": { "$any": true },
              "sideEffects": {},
              "warnings": [
                {
                  "code": "IRREVERSIBLE",
                  "subject": { "contentId": { "$ref": "clip.contentId" } },
                  "data": null
                }
              ],
              "job": null,
              "clamped": []
            },
            "error": null
          }
        }
      }
    }
  ]
}
