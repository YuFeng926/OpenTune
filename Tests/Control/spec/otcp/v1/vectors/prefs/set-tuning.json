{
  "$schema": "../../schemas/vector.schema.json",
  "id": "prefs/set-tuning",
  "type": "request",
  "description": "prefs.set changes the tuning from 440 Hz to 432 Hz. Preferences are user-global (warning GLOBAL_PREFERENCE), and the new tuning does not recompute existing results (warning NOT_RETROACTIVE). As in OpenTune there is no undo entry; the revert recipe sets 440 Hz again.",
  "capability": "prefs.write",
  "since": "1.0",
  "method": "prefs.set",
  "session": "authenticated",
  "given": { "dirty": false, "preferences": { "tuningHz": 440 } },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "prefs.set",
    "params": { "tuningHz": 432 }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "result": {
      "applied": true,
      "noOp": false,
      "dryRun": false,
      "changes": [
        {
          "entity": "preference",
          "ref": { "preference": "tuningHz" },
          "label": { "$any": true },
          "fields": {
            "tuningHz": { "before": 440, "after": 432, "unit": "hz" }
          }
        }
      ],
      "created": [],
      "removed": [],
      "idMap": [],
      "revisionDiff": {
        "arrangement": null,
        "trackState": null,
        "contents": []
      },
      "tokens": {
        "arrangementRevision": { "$any": "string" },
        "contents": [],
        "placements": []
      },
      "undo": {
        "undoable": false,
        "reason": "ui_parity",
        "revert": { "method": "prefs.set", "params": { "tuningHz": 440 } }
      },
      "dirty": { "before": false, "after": false },
      "ui": { "$any": true },
      "sideEffects": {},
      "warnings": [
        {
          "code": "GLOBAL_PREFERENCE",
          "subject": null,
          "data": { "preferences": ["tuningHz"] }
        },
        {
          "code": "NOT_RETROACTIVE",
          "subject": { "preference": "tuningHz" },
          "data": null
        }
      ],
      "job": null
    }
  },
  "connectionAfter": "open"
}
