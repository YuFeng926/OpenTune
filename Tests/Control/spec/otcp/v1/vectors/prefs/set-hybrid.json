{
  "$schema": "../../schemas/vector.schema.json",
  "id": "prefs/set-hybrid",
  "type": "request",
  "description": "Turning hybrid mode on makes OpenTune render every content again (sideEffects.reRenderQueued).",
  "capability": "prefs.write",
  "since": "1.0",
  "method": "prefs.set",
  "session": "authenticated",
  "given": {
    "dirty": false,
    "preferences": { "hybridMode": false },
    "clips": [
      {
        "bind": "clip",
        "trackId": 0,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "ready"
      }
    ]
  },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "prefs.set",
    "params": { "hybridMode": true }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "result": {
      "applied": true,
      "noOp": false,
      "dryRun": false,
      "changes": [
        {
          "entity": "preference",
          "ref": { "preference": "hybridMode" },
          "label": { "$any": true },
          "fields": {
            "hybridMode": { "before": false, "after": true, "unit": null }
          }
        }
      ],
      "created": [],
      "removed": [],
      "idMap": [],
      "revisionDiff": {
        "arrangement": null,
        "trackState": null,
        "contents": []
      },
      "tokens": {
        "arrangementRevision": { "$any": "string" },
        "contents": [],
        "placements": []
      },
      "undo": {
        "undoable": false,
        "reason": "ui_parity",
        "revert": { "method": "prefs.set", "params": { "hybridMode": false } }
      },
      "dirty": { "before": false, "after": false },
      "ui": { "$any": true },
      "sideEffects": {
        "reRenderQueued": {
          "contentIds": [{ "$ref": "clip.contentId" }],
          "revert": null
        }
      },
      "warnings": [
        {
          "code": "GLOBAL_PREFERENCE",
          "subject": null,
          "data": { "preferences": ["hybridMode"] }
        }
      ],
      "job": null
    }
  },
  "connectionAfter": "open"
}
