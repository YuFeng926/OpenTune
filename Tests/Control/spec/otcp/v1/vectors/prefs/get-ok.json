{
  "$schema": "../../schemas/vector.schema.json",
  "id": "prefs/get-ok",
  "type": "request",
  "description": "prefs.get returns the preferences; with the openDyne editing scheme selected, processing.editingScheme says so. Preferences are not project state, so the result has no asOf.",
  "capability": "read.v1",
  "since": "1.0",
  "method": "prefs.get",
  "session": "authenticated",
  "given": { "editingScheme": "openDyne" },
  "request": { "jsonrpc": "2.0", "id": 1, "method": "prefs.get", "params": {} },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "result": {
      "processing": {
        "tuningHz": { "$any": "number" },
        "editingScheme": "openDyne",
        "hybridMode": { "$any": "boolean" },
        "vocoderWeight": { "$any": true },
        "f0Model": { "$any": true },
        "renderingPriority": { "$any": true },
        "experimentalFeatures": { "$any": "boolean" }
      },
      "onboardingShown": { "$any": "boolean" },
      "language": { "$any": "string" },
      "recentProjects": { "$any": "array" }
    }
  },
  "connectionAfter": "open"
}
