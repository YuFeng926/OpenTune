{
  "$schema": "../../schemas/vector.schema.json",
  "id": "prefs/set-f0-model-noop",
  "type": "request",
  "description": "Setting the pitch model to the one in use is a no-op. fcpe is the only pitch model OpenTune has, so this is the only value prefs.set accepts for f0Model, and the call needs no job.",
  "capability": "prefs.write",
  "since": "1.0",
  "method": "prefs.set",
  "session": "authenticated",
  "given": {
    "dirty": false,
    "preferences": {
      "f0Model": "fcpe",
      "options": { "f0Model": ["fcpe"] }
    }
  },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "prefs.set",
    "params": { "f0Model": "fcpe" }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "result": {
      "applied": true,
      "noOp": true,
      "dryRun": false,
      "changes": [],
      "created": [],
      "removed": [],
      "idMap": [],
      "revisionDiff": {
        "arrangement": null,
        "trackState": null,
        "contents": []
      },
      "tokens": {
        "arrangementRevision": { "$any": "string" },
        "contents": [],
        "placements": []
      },
      "undo": { "undoable": false, "reason": "no_op", "revert": null },
      "dirty": { "before": false, "after": false },
      "ui": { "$any": true },
      "sideEffects": {},
      "warnings": [],
      "job": null
    }
  },
  "connectionAfter": "open"
}
