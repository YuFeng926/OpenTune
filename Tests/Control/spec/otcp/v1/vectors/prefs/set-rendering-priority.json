{
  "$schema": "../../schemas/vector.schema.json",
  "id": "prefs/set-rendering-priority",
  "type": "scenario",
  "description": "Switching the rendering priority from gpuFirst to cpuFirst resets OpenTune's inference backend, which reconfigures the vocoder asynchronously, so the call hands the change to a prefsApply job (PROTOCOL.md section 12.7). The result is the write envelope with the change, the warning GLOBAL_PREFERENCE and the revert recipe with the previous priority. The priority is not audible: the backend reset does not invalidate any render, so the result reports no reRenderQueued side effect (a vector cannot match the absence of a member, so implementations check that in their own tests). prefs.get then reports the new priority.",
  "capability": "prefs.write",
  "extraCapabilities": ["jobs.v1"],
  "since": "1.0",
  "session": "authenticated",
  "given": {
    "dirty": false,
    "preferences": { "renderingPriority": "gpuFirst" }
  },
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "prefs.set",
        "params": { "renderingPriority": "cpuFirst" }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "applied": false,
          "noOp": false,
          "changes": [],
          "undo": null,
          "job": {
            "jobId": { "$capture": "priorityJob", "$any": "string" },
            "kind": "prefsApply",
            "state": { "$any": "string" }
          }
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "job.get",
        "params": { "jobId": { "$ref": "priorityJob" }, "waitMs": 30000 }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": {
          "job": {
            "jobId": { "$ref": "priorityJob" },
            "kind": "prefsApply",
            "state": "succeeded",
            "cancellable": false,
            "createdAtMs": { "$any": "integer" },
            "updatedAtMs": { "$any": "integer" },
            "finishedAtMs": { "$any": "integer" },
            "progress": { "$any": "object" },
            "result": {
              "applied": true,
              "noOp": false,
              "dryRun": false,
              "changes": [
                {
                  "entity": "preference",
                  "ref": { "preference": "renderingPriority" },
                  "label": { "$any": true },
                  "fields": {
                    "renderingPriority": {
                      "before": "gpuFirst",
                      "after": "cpuFirst",
                      "unit": null
                    }
                  }
                }
              ],
              "created": [],
              "removed": [],
              "idMap": [],
              "revisionDiff": {
                "arrangement": null,
                "trackState": null,
                "contents": []
              },
              "tokens": {
                "arrangementRevision": { "$any": "string" },
                "contents": [],
                "placements": []
              },
              "undo": {
                "undoable": false,
                "reason": "ui_parity",
                "revert": {
                  "method": "prefs.set",
                  "params": { "renderingPriority": "gpuFirst" }
                }
              },
              "dirty": { "before": false, "after": false },
              "ui": { "$any": true },
              "sideEffects": {},
              "warnings": [
                {
                  "code": "GLOBAL_PREFERENCE",
                  "subject": null,
                  "data": { "preferences": ["renderingPriority"] }
                }
              ],
              "job": null
            },
            "error": null
          }
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "prefs.get",
        "params": {}
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 3,
        "result": {
          "processing": { "renderingPriority": "cpuFirst" }
        }
      }
    }
  ]
}
