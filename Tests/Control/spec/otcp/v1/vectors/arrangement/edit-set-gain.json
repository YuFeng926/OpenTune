{
  "$schema": "../../schemas/vector.schema.json",
  "id": "arrangement/edit-set-gain",
  "type": "request",
  "description": "op setGain sets the clip gain; changes reports it in dB and as a linear factor.",
  "capability": "arrangement.v1",
  "since": "1.0",
  "method": "arrangement.edit",
  "session": "authenticated",
  "given": {
    "dirty": false,
    "clips": [
      {
        "bind": "clip",
        "trackId": 0,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "ready"
      }
    ]
  },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "arrangement.edit",
    "params": {
      "expectedArrangementRevision": { "$ref": "runner.arrangementRevision" },
      "ops": [
        {
          "op": "setGain",
          "placementId": { "$ref": "clip.placementId" },
          "gainDb": -6
        }
      ]
    }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "result": {
      "applied": true,
      "noOp": false,
      "dryRun": false,
      "changes": [
        {
          "entity": "placement",
          "ref": { "placementId": { "$ref": "clip.placementId" } },
          "label": { "$any": true },
          "fields": {
            "gainDb": { "before": 0, "after": -6, "unit": "db" },
            "gainLinear": {
              "before": 1,
              "after": { "$approx": 0.501187 },
              "unit": "linear"
            }
          }
        }
      ],
      "created": [],
      "removed": [],
      "idMap": [],
      "revisionDiff": {
        "arrangement": {
          "before": { "$ref": "runner.arrangementRevision" },
          "after": { "$any": "string" }
        },
        "trackState": null,
        "contents": []
      },
      "tokens": {
        "arrangementRevision": { "$any": "string" },
        "contents": [],
        "placements": [
          {
            "placementId": { "$ref": "clip.placementId" },
            "geometryHash": { "$any": "string" }
          }
        ]
      },
      "undo": {
        "undoable": true,
        "undoId": { "$any": "string" },
        "description": { "$any": "string" },
        "innerActions": { "$any": "array" },
        "steps": 1
      },
      "dirty": { "before": false, "after": true },
      "ui": { "$any": true },
      "sideEffects": {},
      "warnings": [],
      "job": null
    }
  },
  "connectionAfter": "open"
}
