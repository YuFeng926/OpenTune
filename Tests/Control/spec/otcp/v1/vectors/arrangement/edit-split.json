{
  "$schema": "../../schemas/vector.schema.json",
  "id": "arrangement/edit-split",
  "type": "request",
  "description": "op split cuts a clip at 5 s, a frame boundary of its analysis, into two clips that replace it (removed, created, idMap relation split). The split is undoable with no warning or revert recipe; its retained undo action restores the original placement identity (PROTOCOL.md section 15.3).",
  "capability": "arrangement.v1",
  "since": "1.0",
  "method": "arrangement.edit",
  "session": "authenticated",
  "given": {
    "dirty": false,
    "clips": [
      {
        "bind": "clip",
        "trackId": 0,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "ready"
      }
    ]
  },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "arrangement.edit",
    "params": {
      "expectedArrangementRevision": { "$ref": "runner.arrangementRevision" },
      "ops": [
        {
          "op": "split",
          "placementId": { "$ref": "clip.placementId" },
          "atTimelineSec": 5
        }
      ]
    }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "result": {
      "applied": true,
      "noOp": false,
      "dryRun": false,
      "changes": [],
      "created": [
        {
          "entity": "placement",
          "ref": { "placementId": { "$any": "string" } },
          "label": { "$any": true }
        },
        {
          "entity": "placement",
          "ref": { "placementId": { "$any": "string" } },
          "label": { "$any": true }
        }
      ],
      "removed": [
        {
          "entity": "placement",
          "ref": { "placementId": { "$ref": "clip.placementId" } },
          "label": { "$any": true }
        }
      ],
      "idMap": [
        {
          "entity": "placement",
          "relation": "split",
          "from": [{ "placementId": { "$ref": "clip.placementId" } }],
          "to": [
            { "placementId": { "$any": "string" } },
            { "placementId": { "$any": "string" } }
          ]
        }
      ],
      "revisionDiff": {
        "arrangement": {
          "before": { "$ref": "runner.arrangementRevision" },
          "after": { "$any": "string" }
        },
        "trackState": null,
        "contents": { "$any": "array" }
      },
      "tokens": { "$any": "object" },
      "undo": {
        "undoable": true,
        "undoId": { "$any": "string" },
        "description": { "$any": "string" },
        "innerActions": ["SplitPlacementAction"],
        "steps": 1
      },
      "dirty": { "before": false, "after": true },
      "ui": { "$any": true },
      "sideEffects": {},
      "warnings": [],
      "job": null
    }
  },
  "connectionAfter": "open"
}
