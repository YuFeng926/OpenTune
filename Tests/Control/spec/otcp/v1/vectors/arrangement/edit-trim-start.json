{
  "$schema": "../../schemas/vector.schema.json",
  "id": "arrangement/edit-trim-start",
  "type": "request",
  "description": "op trim with edge start moves the start of a clip later; the start of the part of its content that the clip shows moves with it.",
  "capability": "arrangement.v1",
  "since": "1.0",
  "method": "arrangement.edit",
  "session": "authenticated",
  "given": {
    "dirty": false,
    "clips": [
      {
        "bind": "clip",
        "trackId": 0,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "ready"
      }
    ]
  },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "arrangement.edit",
    "params": {
      "expectedArrangementRevision": { "$ref": "runner.arrangementRevision" },
      "ops": [
        {
          "op": "trim",
          "placementId": { "$ref": "clip.placementId" },
          "edge": "start",
          "toTimelineSec": 3
        }
      ]
    }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "result": {
      "applied": true,
      "noOp": false,
      "dryRun": false,
      "changes": [
        {
          "entity": "placement",
          "ref": { "placementId": { "$ref": "clip.placementId" } },
          "label": { "$any": true },
          "fields": {
            "startTimelineSec": { "before": 2, "after": 3, "unit": "sec" },
            "durationSec": { "before": 6, "after": 5, "unit": "sec" },
            "clipInContentSec": { "before": 0, "after": 1, "unit": "sec" }
          }
        }
      ],
      "created": [],
      "removed": [],
      "idMap": [],
      "revisionDiff": {
        "arrangement": {
          "before": { "$ref": "runner.arrangementRevision" },
          "after": { "$any": "string" }
        },
        "trackState": null,
        "contents": []
      },
      "tokens": {
        "arrangementRevision": { "$any": "string" },
        "contents": [],
        "placements": [
          {
            "placementId": { "$ref": "clip.placementId" },
            "geometryHash": { "$any": "string" }
          }
        ]
      },
      "undo": {
        "undoable": true,
        "undoId": { "$any": "string" },
        "description": { "$any": "string" },
        "innerActions": { "$any": "array" },
        "steps": 1
      },
      "dirty": { "before": false, "after": true },
      "ui": { "$any": true },
      "sideEffects": {},
      "warnings": [],
      "job": null
    }
  },
  "connectionAfter": "open"
}
