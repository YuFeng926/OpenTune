{
  "$schema": "../../schemas/vector.schema.json",
  "id": "arrangement/edit-split-not-ready",
  "type": "request",
  "description": "A split snaps to an analysis frame, so it needs the clip's pitch analysis: while it runs, the call fails with NOT_READY(f0_not_ready).",
  "capability": "arrangement.v1",
  "since": "1.0",
  "method": "arrangement.edit",
  "session": "authenticated",
  "given": {
    "clips": [
      {
        "bind": "clip",
        "trackId": 0,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "running"
      }
    ]
  },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "arrangement.edit",
    "params": {
      "expectedArrangementRevision": { "$ref": "runner.arrangementRevision" },
      "ops": [
        {
          "op": "split",
          "placementId": { "$ref": "clip.placementId" },
          "atTimelineSec": 5
        }
      ]
    }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "error": {
      "code": -32000,
      "message": "NOT_READY",
      "data": {
        "kind": "NOT_READY",
        "reason": "f0_not_ready",
        "retryable": true,
        "detail": { "$any": "string" },
        "executed": false
      }
    }
  },
  "connectionAfter": "open"
}
