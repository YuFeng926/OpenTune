{
  "$schema": "../../schemas/vector.schema.json",
  "id": "import/start-track-capacity",
  "type": "request",
  "description": "layout separateTracks needs one track per file from the target track on. Starting at the last track slot leaves no track for the second file: INVALID_ARGUMENT(track_capacity), and nothing is imported.",
  "capability": "import.v1",
  "since": "1.0",
  "method": "import.start",
  "session": "authenticated",
  "given": {
    "dirty": false,
    "files": [
      { "bind": "take1", "kind": "audio", "durationSec": 4 },
      { "bind": "take2", "kind": "audio", "durationSec": 3 }
    ]
  },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "import.start",
    "params": {
      "items": [
        { "path": { "$ref": "take1" } },
        { "path": { "$ref": "take2" } }
      ],
      "layout": "separateTracks",
      "trackId": { "$ref": "runner.lastTrackId" }
    }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "error": {
      "code": -32602,
      "message": "INVALID_ARGUMENT",
      "data": {
        "kind": "INVALID_ARGUMENT",
        "reason": "track_capacity",
        "retryable": false,
        "detail": { "$any": "string" },
        "executed": false
      }
    }
  },
  "connectionAfter": "open"
}
