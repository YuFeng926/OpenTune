{
  "$schema": "../../schemas/vector.schema.json",
  "id": "import/start-sequential",
  "type": "request",
  "description": "layout sequential places two files end to end on the first track without clips (newTrack), each appended after the previous one.",
  "capability": "import.v1",
  "since": "1.0",
  "method": "import.start",
  "session": "authenticated",
  "given": {
    "dirty": false,
    "files": [
      { "bind": "take1", "kind": "audio", "durationSec": 4 },
      { "bind": "take2", "kind": "audio", "durationSec": 3 }
    ]
  },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "import.start",
    "params": {
      "items": [
        { "path": { "$ref": "take1" } },
        { "path": { "$ref": "take2" } }
      ],
      "layout": "sequential",
      "newTrack": true
    }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "result": {
      "applied": false,
      "noOp": false,
      "dryRun": false,
      "changes": [],
      "created": [],
      "removed": [],
      "idMap": [],
      "revisionDiff": {
        "arrangement": null,
        "trackState": null,
        "contents": []
      },
      "tokens": { "$any": "object" },
      "undo": null,
      "dirty": { "before": false, "after": false },
      "ui": { "$any": true },
      "sideEffects": {},
      "warnings": [],
      "job": {
        "jobId": { "$any": "string" },
        "kind": "import",
        "state": { "$any": "string" }
      }
    }
  },
  "connectionAfter": "open"
}
