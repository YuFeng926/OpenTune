{
  "$schema": "../../schemas/vector.schema.json",
  "id": "transport/set-loop-no-op",
  "type": "request",
  "description": "Turning off a loop flag that is off is a no-op.",
  "capability": "transport.v1",
  "since": "1.0",
  "method": "transport.setLoop",
  "session": "authenticated",
  "given": { "dirty": false },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "transport.setLoop",
    "params": { "enabled": false }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "result": {
      "applied": true,
      "noOp": true,
      "dryRun": false,
      "changes": [],
      "created": [],
      "removed": [],
      "idMap": [],
      "revisionDiff": {
        "arrangement": null,
        "trackState": null,
        "contents": []
      },
      "tokens": {
        "arrangementRevision": { "$any": "string" },
        "contents": [],
        "placements": []
      },
      "undo": { "undoable": false, "reason": "no_op", "revert": null },
      "dirty": { "before": false, "after": false },
      "ui": { "$any": true },
      "sideEffects": {},
      "warnings": [],
      "job": null,
      "transport": {
        "playing": false,
        "positionTimelineSec": 0,
        "playStartTimelineSec": 0,
        "loopEnabled": false,
        "bpm": 120,
        "timeSignature": { "numerator": 4, "denominator": 4 },
        "audioDeviceRunning": { "$any": "boolean" },
        "lastControl": { "$any": true }
      }
    }
  },
  "connectionAfter": "open"
}
