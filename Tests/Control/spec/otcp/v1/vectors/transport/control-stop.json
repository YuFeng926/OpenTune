{
  "$schema": "../../schemas/vector.schema.json",
  "id": "transport/control-stop",
  "type": "scenario",
  "description": "action stop stops playback as OpenTune's stop button does; the result reports the position it leaves.",
  "capability": "transport.v1",
  "since": "1.0",
  "session": "authenticated",
  "given": { "audio": { "running": true } },
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "transport.control",
        "params": { "action": "play" }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": { "applied": true, "transport": { "playing": true } }
      }
    },
    { "pauseMs": 300 },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "transport.control",
        "params": { "action": "stop" }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": {
          "applied": true,
          "noOp": false,
          "undo": {
            "undoable": false,
            "reason": "not_persisted_state",
            "revert": null
          },
          "transport": {
            "playing": false,
            "positionTimelineSec": { "$any": "number" }
          }
        }
      }
    }
  ]
}
