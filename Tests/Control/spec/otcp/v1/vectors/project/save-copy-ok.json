{
  "$schema": "../../schemas/vector.schema.json",
  "id": "project/save-copy-ok",
  "type": "request",
  "description": "project.saveCopy hands the copy to a job of kind projectCopy and changes nothing itself. The project has a file and unsaved changes, and the result shows that both stay as they were (dirty before and after are true, changes is empty); the target is a new path that is not the project's file.",
  "capability": "project.copy",
  "since": "1.0",
  "method": "project.saveCopy",
  "session": "authenticated",
  "given": {
    "dirty": true,
    "clips": [
      {
        "bind": "clip",
        "trackId": 0,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "ready"
      }
    ],
    "files": [
      { "bind": "proj", "kind": "existing", "extension": ".otproj" },
      { "bind": "copy", "kind": "absent", "extension": ".otproj" }
    ],
    "projectFile": "proj"
  },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "project.saveCopy",
    "params": { "path": { "$ref": "copy" } }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "result": {
      "applied": false,
      "noOp": false,
      "dryRun": false,
      "changes": [],
      "created": [],
      "removed": [],
      "idMap": [],
      "revisionDiff": {
        "arrangement": null,
        "trackState": null,
        "contents": []
      },
      "tokens": { "$any": "object" },
      "undo": null,
      "dirty": { "before": true, "after": true },
      "ui": { "$any": true },
      "sideEffects": {},
      "warnings": [],
      "job": {
        "jobId": { "$any": "string" },
        "kind": "projectCopy",
        "state": { "$any": "string" }
      }
    }
  },
  "connectionAfter": "open"
}
