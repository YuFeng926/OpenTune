{
  "$schema": "../../schemas/vector.schema.json",
  "id": "project/open-media-missing",
  "type": "scenario",
  "description": "A project whose media file does not exist opens without that clip: skipped lists the file and the clip, and the result carries the warning MEDIA_MISSING. The previous project was never saved, so revert is null (warning IRREVERSIBLE).",
  "capability": "project.io",
  "extraCapabilities": ["jobs.v1"],
  "since": "1.0",
  "session": "authenticated",
  "given": {
    "dirty": false,
    "files": [
      {
        "bind": "proj",
        "kind": "projectMissingMedia",
        "extension": ".otproj",
        "durationSec": 4
      }
    ]
  },
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "project.open",
        "params": { "path": { "$ref": "proj" } }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "job": {
            "jobId": { "$capture": "missingJob", "$any": "string" },
            "kind": "projectOpen",
            "state": { "$any": "string" }
          }
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "job.get",
        "params": { "jobId": { "$ref": "missingJob" }, "waitMs": 30000 }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": {
          "job": {
            "jobId": { "$ref": "missingJob" },
            "kind": "projectOpen",
            "state": "succeeded",
            "cancellable": false,
            "createdAtMs": { "$any": "integer" },
            "updatedAtMs": { "$any": "integer" },
            "finishedAtMs": { "$any": "integer" },
            "progress": { "$any": "object" },
            "result": {
              "applied": true,
              "noOp": false,
              "dryRun": false,
              "changes": [
                {
                  "entity": "project",
                  "ref": { "singleton": "project" },
                  "label": { "$any": true },
                  "fields": {
                    "path": {
                      "before": null,
                      "after": { "$ref": "proj" },
                      "unit": null
                    }
                  }
                }
              ],
              "created": [],
              "removed": [],
              "idMap": [],
              "revisionDiff": {
                "arrangement": {
                  "before": { "$any": "string" },
                  "after": { "$any": "string" }
                },
                "trackState": { "$any": true },
                "contents": { "$any": "array" }
              },
              "tokens": { "$any": "object" },
              "undo": {
                "undoable": false,
                "reason": "no_upstream_undo",
                "revert": null
              },
              "dirty": { "before": false, "after": false },
              "ui": { "$any": true },
              "sideEffects": {},
              "warnings": [
                {
                  "code": "IRREVERSIBLE",
                  "subject": { "singleton": "project" },
                  "data": null
                },
                {
                  "code": "MEDIA_MISSING",
                  "subject": null,
                  "data": { "paths": [{ "$any": "string" }] }
                }
              ],
              "job": null,
              "path": { "$ref": "proj" },
              "previous": { "path": null, "dirty": false, "discarded": false },
              "restored": {
                "placementCount": 0,
                "contentCount": 0,
                "visibleTrackCount": { "$any": "integer" }
              },
              "skipped": {
                "media": [
                  { "path": { "$any": "string" }, "reason": "missing" }
                ],
                "placementCount": 1
              },
              "historyCleared": { "undoCount": 0, "redoCount": 0 },
              "omittedCount": { "created": 0, "removed": 0 }
            },
            "error": null
          }
        }
      }
    }
  ]
}
