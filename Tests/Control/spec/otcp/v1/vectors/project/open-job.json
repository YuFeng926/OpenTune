{
  "$schema": "../../schemas/vector.schema.json",
  "id": "project/open-job",
  "type": "scenario",
  "description": "The projectOpen job replaces the project with the one in the file: created lists its clip and content, the undo history is cleared, and the project has no unsaved changes. The previous project was saved and unchanged, so the revert recipe opens its file again.",
  "capability": "project.io",
  "extraCapabilities": ["jobs.v1"],
  "since": "1.0",
  "session": "authenticated",
  "given": {
    "dirty": false,
    "files": [
      {
        "bind": "proj",
        "kind": "project",
        "extension": ".otproj",
        "durationSec": 4
      },
      { "bind": "prev", "kind": "existing", "extension": ".otproj" }
    ],
    "projectFile": "prev"
  },
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "project.open",
        "params": { "path": { "$ref": "proj" } }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "job": {
            "jobId": { "$capture": "openJob", "$any": "string" },
            "kind": "projectOpen",
            "state": { "$any": "string" }
          }
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "job.get",
        "params": { "jobId": { "$ref": "openJob" }, "waitMs": 30000 }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": {
          "job": {
            "jobId": { "$ref": "openJob" },
            "kind": "projectOpen",
            "state": "succeeded",
            "cancellable": false,
            "createdAtMs": { "$any": "integer" },
            "updatedAtMs": { "$any": "integer" },
            "finishedAtMs": { "$any": "integer" },
            "progress": { "$any": "object" },
            "result": {
              "applied": true,
              "noOp": false,
              "dryRun": false,
              "changes": [
                {
                  "entity": "project",
                  "ref": { "singleton": "project" },
                  "label": { "$any": true },
                  "fields": {
                    "path": {
                      "before": { "$ref": "prev" },
                      "after": { "$ref": "proj" },
                      "unit": null
                    }
                  }
                }
              ],
              "created": [
                {
                  "entity": "placement",
                  "ref": { "placementId": { "$any": "string" } },
                  "label": { "$any": true }
                },
                {
                  "entity": "content",
                  "ref": { "contentId": { "$any": "string" } },
                  "label": { "$any": true }
                }
              ],
              "removed": [],
              "idMap": [],
              "revisionDiff": {
                "arrangement": {
                  "before": { "$any": "string" },
                  "after": { "$any": "string" }
                },
                "trackState": { "$any": true },
                "contents": { "$any": "array" }
              },
              "tokens": { "$any": "object" },
              "undo": {
                "undoable": false,
                "reason": "no_upstream_undo",
                "revert": {
                  "method": "project.open",
                  "params": { "path": { "$ref": "prev" } }
                }
              },
              "dirty": { "before": false, "after": false },
              "ui": { "$any": true },
              "sideEffects": {},
              "warnings": [],
              "job": null,
              "path": { "$ref": "proj" },
              "previous": {
                "path": { "$ref": "prev" },
                "dirty": false,
                "discarded": false
              },
              "restored": {
                "placementCount": 1,
                "contentCount": 1,
                "visibleTrackCount": { "$any": "integer" }
              },
              "skipped": {
                "media": [],
                "placementCount": 0
              },
              "historyCleared": { "undoCount": 0, "redoCount": 0 },
              "omittedCount": { "created": 0, "removed": 0 }
            },
            "error": null
          }
        }
      }
    }
  ]
}
