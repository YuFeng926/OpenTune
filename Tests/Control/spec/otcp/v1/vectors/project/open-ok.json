{
  "$schema": "../../schemas/vector.schema.json",
  "id": "project/open-ok",
  "type": "request",
  "description": "project.open hands the opening to a job of kind projectOpen and changes nothing itself.",
  "capability": "project.io",
  "since": "1.0",
  "method": "project.open",
  "session": "authenticated",
  "given": {
    "dirty": false,
    "files": [
      {
        "bind": "proj",
        "kind": "project",
        "extension": ".otproj",
        "durationSec": 4
      }
    ]
  },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "project.open",
    "params": { "path": { "$ref": "proj" } }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "result": {
      "applied": false,
      "noOp": false,
      "dryRun": false,
      "changes": [],
      "created": [],
      "removed": [],
      "idMap": [],
      "revisionDiff": {
        "arrangement": null,
        "trackState": null,
        "contents": []
      },
      "tokens": { "$any": "object" },
      "undo": null,
      "dirty": { "before": false, "after": false },
      "ui": { "$any": true },
      "sideEffects": {},
      "warnings": [],
      "job": {
        "jobId": { "$any": "string" },
        "kind": "projectOpen",
        "state": { "$any": "string" }
      }
    }
  },
  "connectionAfter": "open"
}
