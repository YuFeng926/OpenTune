{
  "$schema": "../../schemas/vector.schema.json",
  "id": "project/save-copy-exists-current",
  "type": "request",
  "description": "The current project file is a file that exists like any other: project.saveCopy with path naming it fails with ALREADY_EXISTS(target_exists) and does nothing. (project.saveAs to the current project file is a save; a copy is never a save of the project file.)",
  "capability": "project.copy",
  "since": "1.0",
  "method": "project.saveCopy",
  "session": "authenticated",
  "given": {
    "dirty": true,
    "clips": [
      {
        "bind": "clip",
        "trackId": 0,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "ready"
      }
    ],
    "files": [{ "bind": "proj", "kind": "existing", "extension": ".otproj" }],
    "projectFile": "proj"
  },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "project.saveCopy",
    "params": { "path": { "$ref": "proj" } }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "error": {
      "code": -32000,
      "message": "ALREADY_EXISTS",
      "data": {
        "kind": "ALREADY_EXISTS",
        "reason": "target_exists",
        "retryable": false,
        "detail": { "$any": "string" },
        "executed": false
      }
    }
  },
  "connectionAfter": "open"
}
