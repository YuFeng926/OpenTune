{
  "$schema": "../../schemas/vector.schema.json",
  "id": "project/save-as-job",
  "type": "scenario",
  "description": "The job of project.saveAs writes the new file, which becomes the project's file (changes, entity project), and clears the unsaved-changes flag.",
  "capability": "project.io",
  "extraCapabilities": ["jobs.v1"],
  "since": "1.0",
  "session": "authenticated",
  "given": {
    "dirty": true,
    "clips": [
      {
        "bind": "clip",
        "trackId": 0,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "ready"
      }
    ],
    "files": [{ "bind": "target", "kind": "absent", "extension": ".otproj" }]
  },
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "project.saveAs",
        "params": { "path": { "$ref": "target" } }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "job": {
            "jobId": { "$capture": "saveAsJob", "$any": "string" },
            "kind": "projectSave",
            "state": { "$any": "string" }
          }
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "job.get",
        "params": { "jobId": { "$ref": "saveAsJob" }, "waitMs": 30000 }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": {
          "job": {
            "jobId": { "$ref": "saveAsJob" },
            "kind": "projectSave",
            "state": "succeeded",
            "cancellable": false,
            "createdAtMs": { "$any": "integer" },
            "updatedAtMs": { "$any": "integer" },
            "finishedAtMs": { "$any": "integer" },
            "progress": { "$any": "object" },
            "result": {
              "applied": true,
              "noOp": false,
              "dryRun": false,
              "changes": [
                {
                  "entity": "project",
                  "ref": { "singleton": "project" },
                  "label": { "$any": true },
                  "fields": {
                    "path": {
                      "before": null,
                      "after": { "$ref": "target" },
                      "unit": null
                    }
                  }
                }
              ],
              "created": [],
              "removed": [],
              "idMap": [],
              "revisionDiff": {
                "arrangement": null,
                "trackState": null,
                "contents": []
              },
              "tokens": { "$any": "object" },
              "undo": {
                "undoable": false,
                "reason": "no_upstream_undo",
                "revert": null
              },
              "dirty": { "before": true, "after": false },
              "ui": { "$any": true },
              "sideEffects": {},
              "warnings": [
                {
                  "code": "IRREVERSIBLE",
                  "subject": { "singleton": "project" },
                  "data": null
                },
                {
                  "code": "NOT_SAVED_IN_PROJECT",
                  "subject": null,
                  "data": {
                    "items": ["undoHistory", "preferences"]
                  }
                }
              ],
              "job": null,
              "path": { "$ref": "target" },
              "sizeBytes": { "$any": "integer" }
            },
            "error": null
          }
        }
      }
    }
  ]
}
