{
  "$schema": "../../schemas/vector.schema.json",
  "id": "project/save-as-new",
  "type": "request",
  "description": "project.saveAs to a path where no file exists hands the save to a job of kind projectSave.",
  "capability": "project.io",
  "since": "1.0",
  "method": "project.saveAs",
  "session": "authenticated",
  "given": {
    "dirty": true,
    "clips": [
      {
        "bind": "clip",
        "trackId": 0,
        "startTimelineSec": 2,
        "durationSec": 6,
        "analysis": "ready"
      }
    ],
    "files": [{ "bind": "target", "kind": "absent", "extension": ".otproj" }]
  },
  "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "project.saveAs",
    "params": { "path": { "$ref": "target" } }
  },
  "response": {
    "jsonrpc": "2.0",
    "id": 1,
    "result": {
      "applied": false,
      "noOp": false,
      "dryRun": false,
      "changes": [],
      "created": [],
      "removed": [],
      "idMap": [],
      "revisionDiff": {
        "arrangement": null,
        "trackState": null,
        "contents": []
      },
      "tokens": { "$any": "object" },
      "undo": null,
      "dirty": { "before": true, "after": true },
      "ui": { "$any": true },
      "sideEffects": {},
      "warnings": [],
      "job": {
        "jobId": { "$any": "string" },
        "kind": "projectSave",
        "state": { "$any": "string" }
      }
    }
  },
  "connectionAfter": "open"
}
